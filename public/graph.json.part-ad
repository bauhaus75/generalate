t": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 97, "letter_url": "/letters/97/"}, {"id": "e839", "source": "letter:97", "target": "person:demstero-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 97, "letter_url": "/letters/97/"}, {"id": "e840", "source": "letter:97", "target": "place:spoleto", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 97, "letter_url": "/letters/97/"}, {"id": "e841", "source": "letter:98", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e842", "source": "letter:98", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I ceased for some time to press Your Paternity for the mission of the Indies, from which for my sins I have deserved for this time to be excluded."], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e843", "source": "letter:98", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e844", "source": "letter:98", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e845", "source": "letter:98", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e846", "source": "letter:98", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e847", "source": "letter:98", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e848", "source": "letter:98", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["nevertheless I pray you to be pleased that in this time too you give ear to His Divine Majesty, who calls me and prepares me for the other Mission, which they say should be near at hand with the coming of the Father Proc"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e849", "source": "letter:98", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e850", "source": "letter:98", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e851", "source": "letter:98", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 98, "letter_url": "/letters/98/"}, {"id": "e852", "source": "letter:99", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I had hoped by this hour to have begun, with the others, the so-longed-for Mission of the Indies, when I find myself unexpectedly shut out of so happy an election: and what most afflicts my soul is the doubt that such an"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e853", "source": "letter:99", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e854", "source": "letter:99", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e855", "source": "letter:99", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e856", "source": "letter:99", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e857", "source": "letter:99", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e858", "source": "letter:99", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e859", "source": "letter:99", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 99, "letter_url": "/letters/99/"}, {"id": "e860", "source": "letter:100", "target": "person:demstero-francesco", "type": "written_by", "label": "written by", "evidence": ["Index of Authors"], "letter": 100, "letter_url": "/letters/100/"}, {"id": "e861", "source": "letter:101", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e862", "source": "letter:101", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e863", "source": "letter:101", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e864", "source": "letter:101", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e865", "source": "letter:101", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e866", "source": "letter:101", "target": "person:mastrilli-marcello", "type": "mentions_person", "label": "mentions", "evidence": ["The most glorious death of Father Marcello Mastrilli has moved the whole world;"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e867", "source": "letter:101", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["But I hope that Saint Francis Xavier will present them to you on my behalf, and will suggest to you those reasons that I do not know how to write to you."], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e868", "source": "letter:101", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["Now that the coming of the Father Procurator of China is awaited, asking it with these infinite [desires], I beg Your Paternity, for [the love] of so great glory of God and of the Society in those parts, not to rebuff me"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e869", "source": "letter:101", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["and I believe that Your Paternity has received, on this occasion, thousands of letters from persons asking for the Indies."], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e870", "source": "letter:101", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e871", "source": "letter:101", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e872", "source": "letter:101", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 101, "letter_url": "/letters/101/"}, {"id": "e873", "source": "letter:102", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I do not know what more to take hold of in order to console in some part my soul, so greatly afflicted by the solicitude and anxiety of bringing to completion the ancient desire for the Mission of Japan;"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e874", "source": "letter:102", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e875", "source": "letter:102", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e876", "source": "letter:102", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e877", "source": "letter:102", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e878", "source": "letter:102", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e879", "source": "letter:102", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e880", "source": "letter:102", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 102, "letter_url": "/letters/102/"}, {"id": "e881", "source": "letter:103", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Although for the present there seems no near opportunity for the Indies, nevertheless, to show my desire and the great affection that God deigns to communicate to me for this most glorious Mission, I return to make new i"], "letter": 103, "letter_url": "/letters/103/"}, {"id": "e882", "source": "letter:103", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 103, "letter_url": "/letters/103/"}, {"id": "e883", "source": "letter:103", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 103, "letter_url": "/letters/103/"}, {"id": "e884", "source": "letter:103", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 103, "letter_url": "/letters/103/"}, {"id": "e885", "source": "letter:103", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 103, "letter_url": "/letters/103/"}, {"id": "e886", "source": "letter:104", "target": "place:india", "type": "aspires_to", "label": "desires to travel to", "evidence": ["For the love of God, and by as much as you desire His glory, designate me for India;", "and if you would show me a sign of your benignity, send me the crucifix that you were to send me when I was once before admonished — or at least declare that the crucifix I keep shall stand in place of the one owed to me"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e887", "source": "letter:104", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e888", "source": "letter:104", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e889", "source": "letter:104", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e890", "source": "letter:104", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e891", "source": "letter:104", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Meanwhile I beg my great Apostle and Captain Francis Xavier to plead my cause, since so many of my letters can avail so little by reason of my sins."], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e892", "source": "letter:104", "target": "place:india", "type": "mentions_place", "label": "mentions", "evidence": ["For the love of God, and by as much as you desire His glory, designate me for India;", "and if you would show me a sign of your benignity, send me the crucifix that you were to send me when I was once before admonished — or at least declare that the crucifix I keep shall stand in place of the one owed to me"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e893", "source": "letter:104", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["O God, why do I not find myself in Rome, cast at your most benign feet, showing my affection and the desire that has so long burned in my heart?"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e894", "source": "letter:104", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e895", "source": "letter:104", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e896", "source": "letter:104", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 104, "letter_url": "/letters/104/"}, {"id": "e897", "source": "letter:105", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e898", "source": "letter:105", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e899", "source": "letter:105", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e900", "source": "letter:105", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e901", "source": "letter:105", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e902", "source": "letter:105", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e903", "source": "letter:105", "target": "person:arganantio-domenico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e904", "source": "letter:105", "target": "place:noto", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 105, "letter_url": "/letters/105/"}, {"id": "e905", "source": "letter:106", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I therefore greatly desire to labor as much as I can for the salvation and conversion of souls, and to serve my Lord in Japan, or in some other part of the Indies, scattering my health, my blood, and my life for the love"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e906", "source": "letter:106", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I therefore greatly desire to labor as much as I can for the salvation and conversion of souls, and to serve my Lord in Japan, or in some other part of the Indies, scattering my health, my blood, and my life for the love", "First, because the Lord gives me to understand that for the salvation of my soul there is no means safer, nor easier, nor more fitting than to go laboring through those spacious regions of the Indies, where so many souls"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e907", "source": "letter:106", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e908", "source": "letter:106", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e909", "source": "letter:106", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e910", "source": "letter:106", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e911", "source": "letter:106", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e912", "source": "letter:106", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e913", "source": "letter:106", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e914", "source": "letter:106", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e915", "source": "letter:106", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e916", "source": "letter:106", "target": "place:palermo", "type": "mentions_place", "label": "mentions", "evidence": ["Moreover I have already finished the course of philosophy, and this is my first year of school, which I am doing in Palermo;"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e917", "source": "letter:106", "target": "place:sicily", "type": "mentions_place", "label": "mentions", "evidence": ["and leaving Sicily altogether, my country, my kinsmen, and my acquaintance, causes me no difficulty."], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e918", "source": "letter:106", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e919", "source": "letter:106", "target": "person:amabilina-marzio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e920", "source": "letter:106", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 106, "letter_url": "/letters/106/"}, {"id": "e921", "source": "letter:107", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["for if you will, I do not believe a readier occasion could offer itself than the present one, which we are advised of from China by one of our Sicilian Fathers — namely, the coming of Father Alvaro Semedo, Procurator of "], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e922", "source": "letter:107", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote to Your Paternity last October recalling my ancient desire for the Mission of Japan;"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e923", "source": "letter:107", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e924", "source": "letter:107", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e925", "source": "letter:107", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e926", "source": "letter:107", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e927", "source": "letter:107", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e928", "source": "letter:107", "target": "person:semedo-alvaro", "type": "mentions_person", "label": "mentions", "evidence": ["for if you will, I do not believe a readier occasion could offer itself than the present one, which we are advised of from China by one of our Sicilian Fathers — namely, the coming of Father Alvaro Semedo, Procurator of "], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e929", "source": "letter:107", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e930", "source": "letter:107", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e931", "source": "letter:107", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 107, "letter_url": "/letters/107/"}, {"id": "e932", "source": "letter:108", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The offering of the Holy Child Jesus to His eternal Father in the Temple — whose feast we celebrated the day before yesterday — and that which, tomorrow being so many years since, our three holy Martyrs made to the same "], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e933", "source": "letter:108", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e934", "source": "letter:108", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e935", "source": "letter:108", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e936", "source": "letter:108", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e937", "source": "letter:108", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e938", "source": "letter:108", "target": "person:barbarito-giovanni-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e939", "source": "letter:108", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 108, "letter_url": "/letters/108/"}, {"id": "e940", "source": "letter:109", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Our Father, let not Your Paternity abandon me in this fine opportunity of these happy tidings that come to us, by the Divine grace, from China."], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e941", "source": "letter:109", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e942", "source": "letter:109", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e943", "source": "letter:109", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e944", "source": "letter:109", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e945", "source": "letter:109", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e946", "source": "letter:109", "target": "person:arganantio-domenico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e947", "source": "letter:109", "target": "place:noto", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 109, "letter_url": "/letters/109/"}, {"id": "e948", "source": "letter:110", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Ever since my novitiate God Our Lord has given me a lively desire to ask for the Mission of the Indies;"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e949", "source": "letter:110", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e950", "source": "letter:110", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e951", "source": "letter:110", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e952", "source": "letter:110", "target": "person:arisco-lorenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e953", "source": "letter:110", "target": "place:caltagirone", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 110, "letter_url": "/letters/110/"}, {"id": "e954", "source": "letter:111", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Your Paternity knows the desire which God of His grace has granted me, to go and serve Him as His laborer in the Indies;", "I, prostrate with all affection before the feet of Your Paternity, beg in Visceribus Christi (in the heart of Christ) to grant me this grace: to give me as companion to the Father Procurator of Portugal, from whence I ma"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e955", "source": "letter:111", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e956", "source": "letter:111", "target": "place:portugal", "type": "mentions_place", "label": "mentions", "evidence": ["Now I have spoken here with the Father Procurator of Portugal, whom I understand must be provided with a companion as far as Portugal.", "and His Reverence does not refuse me, but with sincere affection refers everything to the election of Your Paternity, to whom he tells me he will write, and whom the Father Assistant of Portugal will also beseech in my f"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e957", "source": "letter:111", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e958", "source": "letter:111", "target": "person:basile-giacomo-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e959", "source": "letter:111", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 111, "letter_url": "/letters/111/"}, {"id": "e960", "source": "letter:112", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I conveyed to Your Paternity, in two letters of mine sent to him by Father Fabio a few months ago, the sentiments and desires which it pleased His Divine Majesty to give me concerning the Mission of the Indies — for His "], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e961", "source": "letter:112", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e962", "source": "letter:112", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e963", "source": "letter:112", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e964", "source": "letter:112", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e965", "source": "letter:112", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e966", "source": "letter:112", "target": "person:albergati-federico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e967", "source": "letter:112", "target": "place:faenza", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 112, "letter_url": "/letters/112/"}, {"id": "e968", "source": "letter:113", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Now that I find myself, by the grace of the Lord, at the end both of my studies and of my fifth year of school, I come anew to beseech Your Paternity for the grace for which I have beseeched him at other times, both by l"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e969", "source": "letter:113", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e970", "source": "letter:113", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e971", "source": "letter:113", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e972", "source": "letter:113", "target": "person:vimercati-orazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e973", "source": "letter:113", "target": "place:cremona", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 113, "letter_url": "/letters/113/"}, {"id": "e974", "source": "letter:114", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e975", "source": "letter:114", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e976", "source": "letter:114", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e977", "source": "letter:114", "target": "person:mastrilli-marcello", "type": "mentions_person", "label": "mentions", "evidence": ["Upon hearing read aloud the glorious end of our Father Marcello Mastrilli, the Lord deigned to stir in my soul a most ardent desire to be his imitator, employing myself for the spiritual benefit of the Gentiles;"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e978", "source": "letter:114", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e979", "source": "letter:114", "target": "person:buscemi-tomaso", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e980", "source": "letter:114", "target": "place:piazza", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 114, "letter_url": "/letters/114/"}, {"id": "e981", "source": "letter:115", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Confiding therefore in the great benignity of Your Paternity, I do not weary of multiplying letters to lay open the ardent and kindled desires of my heart concerning the mission of the Indies;"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e982", "source": "letter:115", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e983", "source": "letter:115", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e984", "source": "letter:115", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e985", "source": "letter:115", "target": "person:arganantio-domenico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e986", "source": "letter:115", "target": "place:noto", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 115, "letter_url": "/letters/115/"}, {"id": "e987", "source": "letter:116", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e988", "source": "letter:116", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I write anew to Your Paternity concerning my Vocation to Japan, beseeching him with the most heartfelt affection of my soul to have compassion on a son of his in Christ in so pious a matter;"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e989", "source": "letter:116", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e990", "source": "letter:116", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e991", "source": "letter:116", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e992", "source": "letter:116", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e993", "source": "letter:116", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e994", "source": "letter:116", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["And though the cause may perhaps be the lack of opportunity — the Procurator of China not having come — yet I cannot be quieted, knowing that Your Paternity, this notwithstanding, can console me, as he has just now done "], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e995", "source": "letter:116", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e996", "source": "letter:116", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e997", "source": "letter:116", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 116, "letter_url": "/letters/116/"}, {"id": "e998", "source": "letter:117", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The ardent desire which the Lord once deigned to awaken in my breast, to go to the most needy and perilous parts of the Indies for the increase of His Holy Faith, He has deigned also to preserve in me until now — as I ho"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e999", "source": "letter:117", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e1000", "source": "letter:117", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e1001", "source": "letter:117", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e1002", "source": "letter:117", "target": "person:barbarito-felice", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e1003", "source": "letter:117", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 117, "letter_url": "/letters/117/"}, {"id": "e1004", "source": "letter:118", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I recall my desire for the India mission, now that Your Paternity is about to send subjects to China."], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1005", "source": "letter:118", "target": "place:india", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I recall my desire for the India mission, now that Your Paternity is about to send subjects to China.", "For the rest, I am ready all my life to teach school and every other exercise, should the so-desired India mission fail me through my unfitness."], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1006", "source": "letter:118", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1007", "source": "letter:118", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1008", "source": "letter:118", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1009", "source": "letter:118", "target": "place:india", "type": "mentions_place", "label": "mentions", "evidence": ["I recall my desire for the India mission, now that Your Paternity is about to send subjects to China.", "For the rest, I am ready all my life to teach school and every other exercise, should the so-desired India mission fail me through my unfitness."], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1010", "source": "letter:118", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1011", "source": "letter:118", "target": "person:arcamone-ignatio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1012", "source": "letter:118", "target": "place:bari", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 118, "letter_url": "/letters/118/"}, {"id": "e1013", "source": "letter:119", "target": "place:india", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I am forced to petition Your Paternity to put into execution the Vow already granted me, of the India mission."], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1014", "source": "letter:119", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1015", "source": "letter:119", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1016", "source": "letter:119", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1017", "source": "letter:119", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1018", "source": "letter:119", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1019", "source": "letter:119", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1020", "source": "letter:119", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1021", "source": "letter:119", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["I set before Your Paternity only the most copious sweats shed by my great Father and Apostle Saint Francis Xavier, the precious blood of so many of our holy Martyrs, which call and invite me to the cultivation of those s"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1022", "source": "letter:119", "target": "place:india", "type": "mentions_place", "label": "mentions", "evidence": ["I am forced to petition Your Paternity to put into execution the Vow already granted me, of the India mission."], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1023", "source": "letter:119", "target": "place:italy", "type": "mentions_place", "label": "mentions", "evidence": ["rather, as penance for them I choose to depart from beautiful Italy, to take voluntary exile from relatives and friends, to go among strange or barbarian peoples, to plunge into oceans of sufferings, to end my life on th"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1024", "source": "letter:119", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1025", "source": "letter:119", "target": "person:arcolino-domenico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1026", "source": "letter:119", "target": "place:vicenza", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 119, "letter_url": "/letters/119/"}, {"id": "e1027", "source": "letter:120", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["On the first of last Lent I wrote to Your Paternity a letter in which I disclosed to him the great desire which God our Lord has deigned to give me ever since my novitiate, of serving Him in the Indies, offering myself t"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1028", "source": "letter:120", "target": "topic:angels", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1029", "source": "letter:120", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1030", "source": "letter:120", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1031", "source": "letter:120", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1032", "source": "letter:120", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1033", "source": "letter:120", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1034", "source": "letter:120", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1035", "source": "letter:120", "target": "person:arisco-lorenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1036", "source": "letter:120", "target": "place:caltagirone", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 120, "letter_url": "/letters/120/"}, {"id": "e1037", "source": "letter:121", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1038", "source": "letter:121", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["enough — may that Father of mercies, who, calling me from the world, drew me from a dunghill of sins in which I miserably lay, and who now gives me so fervent a vocation for Japan, efficaciously move Your Paternity to gr"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1039", "source": "letter:121", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1040", "source": "letter:121", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1041", "source": "letter:121", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1042", "source": "letter:121", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1043", "source": "letter:121", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1044", "source": "letter:121", "target": "topic:philippines-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1045", "source": "letter:121", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1046", "source": "letter:121", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1047", "source": "letter:121", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1048", "source": "letter:121", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["Already I hear that the Father Procurator of the Philippines has arrived, and that the Procurator of China is expected: what more is lacking?"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1049", "source": "letter:121", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["and, already cast away upon some shore of Japan, abandoned and deprived of human aid, breathe my last sigh to the Creator — for I dare not promise myself martyrdom, which was so utterly denied to my glorious Saint Franci", "It seems to me, to tell the truth, that I dwell in our own lands as in a prison, while my heart by night and by day journeys through those of Japan, panting for labor and suffering."], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1050", "source": "letter:121", "target": "place:philippines", "type": "mentions_place", "label": "mentions", "evidence": ["Already I hear that the Father Procurator of the Philippines has arrived, and that the Procurator of China is expected: what more is lacking?"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1051", "source": "letter:121", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1052", "source": "letter:121", "target": "person:buscemi-tomaso", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1053", "source": "letter:121", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 121, "letter_url": "/letters/121/"}, {"id": "e1054", "source": "letter:122", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["From the depths of my heart, with most ardent desire, I write to Your Paternity, entreating you anew with the greatest affection I can, for the glorious mission of the Indies;", "and this I can nowhere better accomplish than in the Indies, where I hold it certain that I must one day, with the aid of Him who deigned to communicate to me so holy a desire, arrive."], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1055", "source": "letter:122", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1056", "source": "letter:122", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1057", "source": "letter:122", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1058", "source": "letter:122", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1059", "source": "letter:122", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1060", "source": "letter:122", "target": "person:barbarito-felice", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1061", "source": "letter:122", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 122, "letter_url": "/letters/122/"}, {"id": "e1062", "source": "letter:123", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I am aware that it is not necessary to commend to Your Paternity so often my desire for the Japan mission, believing that you cannot so easily have forgotten my long insistence and fervor: yet today I feel myself inwardl"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1063", "source": "letter:123", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1064", "source": "letter:123", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1065", "source": "letter:123", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1066", "source": "letter:123", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1067", "source": "letter:123", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1068", "source": "letter:123", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1069", "source": "letter:123", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1070", "source": "letter:123", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 123, "letter_url": "/letters/123/"}, {"id": "e1071", "source": "letter:124", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["This very morning I heard here at San [Solio], where I find myself for the vacation, that Your Paternity has already sent to some the most happy news for the Indies — among whom I have not seen myself numbered."], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1072", "source": "letter:124", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1073", "source": "letter:124", "target": "topic:spiritual-exercises", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1074", "source": "letter:124", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1075", "source": "letter:124", "target": "place:san-solio", "type": "mentions_place", "label": "mentions", "evidence": ["This very morning I heard here at San [Solio], where I find myself for the vacation, that Your Paternity has already sent to some the most happy news for the Indies — among whom I have not seen myself numbered."], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1076", "source": "letter:124", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["So let Your Paternity be content, for the love of blessed God, that I may spend these few days, which in His supreme goodness He has deigned to prolong for me, there in the Indies in aid of those poor souls, bereft of th"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1077", "source": "letter:124", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1078", "source": "letter:124", "target": "person:barbarito-giovanni-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1079", "source": "letter:124", "target": "place:san-solio", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 124, "letter_url": "/letters/124/"}, {"id": "e1080", "source": "letter:125", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1081", "source": "letter:125", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["and I have taken such affection to this mission of Japan that I would have all ask for it, and would desire all to employ themselves wholly in aid of those poor souls redeemed with the blood of my Jesus;"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1082", "source": "letter:125", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1083", "source": "letter:125", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1084", "source": "letter:125", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1085", "source": "letter:125", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1086", "source": "letter:125", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1087", "source": "letter:125", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1088", "source": "letter:125", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1089", "source": "letter:125", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1090", "source": "letter:125", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["I think that by now, by God’s grace, the Father Procurator of China has arrived there;"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1091", "source": "letter:125", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1092", "source": "letter:125", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1093", "source": "letter:125", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 125, "letter_url": "/letters/125/"}, {"id": "e1094", "source": "letter:126", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'Japan, mission to' (printed)"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1095", "source": "letter:126", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1096", "source": "letter:126", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1097", "source": "letter:126", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1098", "source": "letter:126", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["The news that comes here of the calling to the Indies of some from the Province of Naples, though on the one hand it has brought me the greatest consolation, as I rejoice in their joy and in the aid they will give to tha"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1099", "source": "letter:126", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["The news that comes here of the calling to the Indies of some from the Province of Naples, though on the one hand it has brought me the greatest consolation, as I rejoice in their joy and in the aid they will give to tha"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1100", "source": "letter:126", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["The news that comes here of the calling to the Indies of some from the Province of Naples, though on the one hand it has brought me the greatest consolation, as I rejoice in their joy and in the aid they will give to tha"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1101", "source": "letter:126", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1102", "source": "letter:126", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1103", "source": "letter:126", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 126, "letter_url": "/letters/126/"}, {"id": "e1104", "source": "letter:127", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Now he calls me to the Indies, and I give notice of it to Your Paternity and supplicate you, as I have done at other times."], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1105", "source": "letter:127", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1106", "source": "letter:127", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1107", "source": "letter:127", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1108", "source": "letter:127", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["but I was healed of a malignant fever by a saint whom I did not know at the time and of whom I had never heard word — and then, having entered the Company, I came to know that the saint I saw in a dream was Saint Xavier.", "For the love of God and of Saint Xavier, who healed me and made me enter the Company, let Your Paternity console me, and at once;"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1109", "source": "letter:127", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["Seeing that from our College there departs for the Indies, at Your Paternity’s command, Giuseppe Plazza, and hearing that many will go, has kindled a flame in my heart that will not let me rest.", "but in the Indies one man will need to do all things."], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1110", "source": "letter:127", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1111", "source": "letter:127", "target": "person:arisco-lorenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1112", "source": "letter:127", "target": "place:caltagirone", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 127, "letter_url": "/letters/127/"}, {"id": "e1113", "source": "letter:128", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Would to the Lord that my pen could answer in kind to what I now feel interiorly communicated to me by that infinite Mercy, and set forth to you effectively the desire I have to see myself employed by Your Paternity in s", "And let Your Paternity believe me, that I would not declare myself to you in this manner were I not wholly resolved — for I have no other consolation but this: that, by the grace of the Lord, one day I shall see myself f"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1114", "source": "letter:128", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1115", "source": "letter:128", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1116", "source": "letter:128", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1117", "source": "letter:128", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1118", "source": "letter:128", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1119", "source": "letter:128", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1120", "source": "letter:128", "target": "person:aliotta-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1121", "source": "letter:128", "target": "place:trapani", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 128, "letter_url": "/letters/128/"}, {"id": "e1122", "source": "letter:129", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The scruple of not wishing to be indiscreet by multiplying letters to Your Paternity more often on the same matter has sufficed to restrain me for some three months from writing to you, and from renewing the memory of th"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1123", "source": "letter:129", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1124", "source": "letter:129", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1125", "source": "letter:129", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["[Archival docket on the letter: Naples, 29 December 1640 — Father Giacomo Antonio Basile — Indies again."], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1126", "source": "letter:129", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["[Archival docket on the letter: Naples, 29 December 1640 — Father Giacomo Antonio Basile — Indies again."], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1127", "source": "letter:129", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1128", "source": "letter:129", "target": "person:basile-giacomo-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1129", "source": "letter:129", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 129, "letter_url": "/letters/129/"}, {"id": "e1130", "source": "letter:130", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["wherefore I should judge myself guilty if I did not strive to correspond, as far as I can, to the desire He gives me to carry out the institute which I hope to take, unless hindered by my faults — especially as He gives "], "letter": 130, "letter_url": "/letters/130/"}, {"id": "e1131", "source": "letter:130", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 130, "letter_url": "/letters/130/"}, {"id": "e1132", "source": "letter:130", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 130, "letter_url": "/letters/130/"}, {"id": "e1133", "source": "letter:130", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 130, "letter_url": "/letters/130/"}, {"id": "e1134", "source": "letter:130", "target": "person:archinto-cristoforo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 130, "letter_url": "/letters/130/"}, {"id": "e1135", "source": "letter:131", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Then, having cast myself at your feet, I come anew to ask of you the so-desired grace of going to Japan, or to whatever part of the lands of the Infidels, that I may satisfy the obligation I have to obey the call of the "], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1136", "source": "letter:131", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1137", "source": "letter:131", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1138", "source": "letter:131", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1139", "source": "letter:131", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1140", "source": "letter:131", "target": "person:lubelli-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1141", "source": "letter:131", "target": "place:massa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 131, "letter_url": "/letters/131/"}, {"id": "e1142", "source": "letter:132", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1143", "source": "letter:132", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I return to Your Paternity to make once more my petition for the Indies, and to recall to you my ardent desires, continued for so long a time.", "nothing remains to me but the blessing of Your Paternity, with which to set myself on the journey — of which he wished to give me a pledge a year and a half ago by sending me the Crucifix of the Indies."], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1144", "source": "letter:132", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1145", "source": "letter:132", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1146", "source": "letter:132", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1147", "source": "letter:132", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1148", "source": "letter:132", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["Already the Father Procurator of China finds himself in Rome, and I find myself disengaged from every other occupation by the particular providence of God, who wishes in this manner to show that He has kept me for the Ea"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1149", "source": "letter:132", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["Already the Father Procurator of China finds himself in Rome, and I find myself disengaged from every other occupation by the particular providence of God, who wishes in this manner to show that He has kept me for the Ea"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1150", "source": "letter:132", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1151", "source": "letter:132", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1152", "source": "letter:132", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 132, "letter_url": "/letters/132/"}, {"id": "e1153", "source": "letter:133", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["To the vow that, with the license of the Father Provincial and the counsel of my spiritual father, Father Geronimo Tagliavia, I made to go and suffer for the love of God in those parts of the Indies, or in whatever other"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1154", "source": "letter:133", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1155", "source": "letter:133", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1156", "source": "letter:133", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1157", "source": "letter:133", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1158", "source": "letter:133", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1159", "source": "letter:133", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1160", "source": "letter:133", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1161", "source": "letter:133", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 133, "letter_url": "/letters/133/"}, {"id": "e1162", "source": "letter:134", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["and in case, by some accident — which the infinite mercy of God forbid — this mission of China should be deferred, Your Paternity at least do me the charity of giving me this happy news, of advising me from now for when "], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1163", "source": "letter:134", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1164", "source": "letter:134", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1165", "source": "letter:134", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1166", "source": "letter:134", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1167", "source": "letter:134", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["But I hope that the Lord, having pity on the tears of certain Indians who are in this College — who truly effundunt animas (they pour out their souls) in the sight of God — will remove every impediment, lest the Devil pr"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1168", "source": "letter:134", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1169", "source": "letter:134", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1170", "source": "letter:134", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 134, "letter_url": "/letters/134/"}, {"id": "e1171", "source": "letter:135", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1172", "source": "letter:135", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1173", "source": "letter:135", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["O that I were in Rome, that I might show you how I burn with desire, and what courage the Lord gives me to go and suffer and labor for His holy name!"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1174", "source": "letter:135", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence