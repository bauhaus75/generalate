  "assignment": null,
  "destination": "japan",
  "dossier": "Wrote 1 letter from Milan (1634) petitioning the General for the foreign missions; requested destination: Japan (1).",
  "letters": [
   {
    "n": 82,
    "year": 1634,
    "date": "April 11, 1634",
    "place": "Milan",
    "archival": "ARSI, FG 740, 78",
    "excerpt": "Since one of the causes that moved me rather to choose the religious state in the Company than in another order was the hope of obtaining one day from my superiors the mission of the Indies, and in particular of those places where there was the greatest occasion of suffering, for this reason, having communicated this vocation of mine many times with my spiritual fathers, and having often commended myself from my heart to the Divine Majesty that it might make known to me its holy will, I have at last resolved to seek with all my power to obtain so great a grace, and I come with this letter of mine to pray Your Paternity to fulfill my desires.",
    "kind": "abridged",
    "full_paras": [
     "Since one of the causes that moved me rather to choose the religious state in the Company than in another order was the hope of obtaining one day from my superiors the mission of the Indies, and in particular of those places where there was the greatest occasion of suffering, for this reason, having communicated this vocation of mine many times with my spiritual fathers, and having often commended myself from my heart to the Divine Majesty that it might make known to me its holy will, I have at last resolved to seek with all my power to obtain so great a grace, and I come with this letter of mine to pray Your Paternity to fulfill my desires. My inclination was from the first for Japan, but since I see the great difficulty there is in obtaining so great a mission, I offer myself to Your Paternity for that of Paraguay, and I await, with the coming of the Father Procurator, that Your Paternity will heed my petitions. For which, begging you with all possible affection, and remembering myself as your most humble son, I commend my miseries to your holy sacrifices and prayers."
    ]
   }
  ]
 },
 {
