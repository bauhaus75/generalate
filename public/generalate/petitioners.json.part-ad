  ]
 },
 {
  "id": "hist-76",
  "fictional": false,
  "name": "Daniello Bartoli",
  "author_raw": "Daniello Bartoli",
  "age": null,
  "yearsInSociety": null,
  "formation": null,
  "studies": null,
  "skills": [],
  "health": null,
  "assignment": null,
  "destination": "east-indies",
  "dossier": "Wrote 2 letters from Parma (1632–1633) petitioning the General for the foreign missions; requested destinations: East Indies (1), China (1).",
  "letters": [
   {
    "n": 76,
    "year": 1632,
    "date": "February 2, 1632",
    "place": "Parma",
    "archival": "ARSI, FG 739, 179",
    "excerpt": "The most ardent desire for the Indies, which by the infinite goodness of the Lord God continues ever greater in me, compels me to ask you for the grace thereof again, as I have done at other times, so now more than ever insistently. I am exceedingly ashamed before the Lord God to utter a word to ask of Your Paternity so great a favor, of which I know myself to be in every respect most unworthy; nevertheless, I do not think that the Lord God has communicated to me in vain such a burning desire to spend all that I have of strength, talent, spirit, and life to labor and to die for the defense of our holy faith and for the help of the unbelievers.",
    "kind": "abridged",
    "full_paras": [
     "The most ardent desire for the Indies, which by the infinite goodness of the Lord God continues ever greater in me, compels me to ask you for the grace thereof again, as I have done at other times, so now more than ever insistently. I am exceedingly ashamed before the Lord God to utter a word to ask of Your Paternity so great a favor, of which I know myself to be in every respect most unworthy; nevertheless, I do not think that the Lord God has communicated to me in vain such a burning desire to spend all that I have of strength, talent, spirit, and life to labor and to die for the defense of our holy faith and for the help of the unbelievers. Let Your Paternity but send me to whatever part of the world pleases you most, to whatever nations, and to do whatever you will; I am most ready for everything; would that I were sufficient. I know that these times are less opportune for the execution of what I ask: let this then serve to obtain from Your Paternity the grace of departure at the first occasion that offers itself to you. And since you cannot have sufficient motive to send me from my goodness and sufficiency, for I am most base and most unfit for so great an undertaking, I supplicate you, by the goodness of the Lord God, to be pleased, so to speak, to venture me, or to place me as an addition to those others who will be most worthy to go. My most beloved Father, I commend myself to you for the grace with all possible affection and humility; and I pray His Divine Majesty to give you, with the fulfillment of all His goods, also this goodwill toward me, while I most humbly kiss your feet, prostrate on the ground."
    ]
   },
   {
    "n": 79,
    "year": 1633,
    "date": "May 16, 1633",
    "place": "Parma",
    "archival": "ARSI, FG 739, 239",
    "excerpt": "Many times I have offered myself to Your Paternity to spend my labors, my blood, and my life in the conversion of souls among the unbelievers and heretics; and I have always had such answer as showed that Your Paternity's good will to grant me the grace lacked nothing but the occasion. Now that the Father Procurator of Peru comes thither to supplicate Your Paternity also, among other things, that you grant him some of Ours for those countries; here I am, Father, most ready at every sign; most desirous, if such be the will of the Lord God, to consume myself wholly in the sufferings and dangers incurred in the conversion of the unbelievers.",
    "kind": "abridged",
    "full_paras": [
     "Many times I have offered myself to Your Paternity to spend my labors, my blood, and my life in the conversion of souls among the unbelievers and heretics; and I have always had such answer as showed that Your Paternity's good will to grant me the grace lacked nothing but the occasion. Now that the Father Procurator of Peru comes thither to supplicate Your Paternity also, among other things, that you grant him some of Ours for those countries; here I am, Father, most ready at every sign; most desirous, if such be the will of the Lord God, to consume myself wholly in the sufferings and dangers incurred in the conversion of the unbelievers. I do not pray you to send me to Peru, or to any other country by name, for I will never add a word that would take from me a total indifference and from Your Paternity a supreme liberty to dispose of me for whatever country pleases you. Only, I signify to you that the desire which has always grown in me since ten years ago it came to me is not to change country, but to spend all my labor, and a thousand lives if I had so many, for the propagation of the holy faith; and where dangers are greater, and greater occasion there is to suffer and to die amid the hardships, or to be killed for this end, thither I feel myself, by Divine grace, the more animated to go; be it Japan, England, China, the Mogul, or any other country. But let it be at least some one; for thus, prostrate at your feet with all the greater affection and humility, I supplicate you for it: praying you, moreover, to give me your paternal blessing."
    ]
   }
  ]
 },
 {
  "id": "hist-81",
  "fictional": false,
  "name": "Gabriele Archinto",
  "author_raw": "Archinto, Gabriele",
  "age": null,
  "yearsInSociety": null,
  "formation": null,
  "studies": null,
  "skills": [],
  "health": null,
  "assignment": null,
  "destination": "east-indies",
  "dossier": "Wrote 2 letters from Milan (1633–1635) petitioning the General for the foreign missions; requested destination: East Indies (2).",
  "letters": [
   {
    "n": 81,
    "year": 1633,
    "date": "June 28, 1633",
    "place": "Milan",
    "archival": "ARSI, FG 739, 251",
    "excerpt": "The continual goad of my divine vocation, which ever urges me on, together with the kindness of Your Paternity shown me in other letters of yours, has given me the assurance to trouble you once again with my tedious letters, all of which end in asking you for the longed-for fulfillment of the so-desired mission of the Indies; and now I ask it all the more warmly, inasmuch as I feel myself burning more than usual, particularly in these holy days of the renewal of vows, with the desire for the end I have so long sighed for.",
    "kind": "abridged",
    "full_paras": [
     "The continual goad of my divine vocation, which ever urges me on, together with the kindness of Your Paternity shown me in other letters of yours, has given me the assurance to trouble you once again with my tedious letters, all of which end in asking you for the longed-for fulfillment of the so-desired mission of the Indies; and now I ask it all the more warmly, inasmuch as I feel myself burning more than usual, particularly in these holy days of the renewal of vows, with the desire for the end I have so long sighed for. And the last contests of the resolution to send me with the present Father Procurator seem nearer, whose departure, as I understood from him, would not be long delayed. I beg you therefore not to hinder so great a consolation to my soul, which with a single nod you can so abundantly grant; and while, in the renewal tomorrow of the oblation of the vows already made, I shall pray the Lord for this, I beg you for the customary earnest of every grace and favor, which is your holy blessing."
    ]
   },
   {
    "n": 84,
    "year": 1635,
    "date": "January 2, 1635",
    "place": "Milan",
    "archival": "ARSI, FG 740, 274",
    "excerpt": "On the occasion of the good beginning of the year, which I pray may be most happy for Your Paternity, I did not wish to neglect to represent to you anew the vehemence of my desire, which grows day by day and will torment me until I am given some nearer hope than I have yet had. I spoke this morning with Father Magaglianes, who with his great charity much enlarged my heart, assuring me that I would obtain from Your Paternity whatever I knew how to ask in this matter. I have recourse therefore to Your Paternity with all confidence, begging you that — since this vocation has now for many years been detained and nourished by me as no small sign of the divine will, and since such good heart has been given me by Father Magaglianes — I beg you, I say, at last to console me by reserving for me a little corner among those who, as I understand, are to depart at the end of this year.",
    "kind": "abridged",
    "full_paras": [
     "On the occasion of the good beginning of the year, which I pray may be most happy for Your Paternity, I did not wish to neglect to represent to you anew the vehemence of my desire, which grows day by day and will torment me until I am given some nearer hope than I have yet had. I spoke this morning with Father Magaglianes, who with his great charity much enlarged my heart, assuring me that I would obtain from Your Paternity whatever I knew how to ask in this matter. I have recourse therefore to Your Paternity with all confidence, begging you that — since this vocation has now for many years been detained and nourished by me as no small sign of the divine will, and since such good heart has been given me by Father Magaglianes — I beg you, I say, at last to console me by reserving for me a little corner among those who, as I understand, are to depart at the end of this year. For which, begging you anew, I anew wish you a happy beginning of this year, and humbly ask your holy blessing."
    ]
   }
  ]
 },
 {
  "id": "hist-82",
  "fictional": false,
  "name": "Alessandro Archinto",
  "author_raw": "Archinto, Alessandro",
  "age": null,
  "yearsInSociety": null,
  "formation": null,
  "studies": null,
  "skills": [],
