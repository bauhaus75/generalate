  "letters": [
   {
    "n": 75,
    "year": 1631,
    "date": "November 5, 1631",
    "place": "Milan",
    "archival": "ARSI, FG 739, 159",
    "excerpt": "Some time ago I wrote to Your Paternity of the vocation to the Indies which Our Lord deigned, from the very beginning of my entrance into Religion, to give me, and of its effect I obtained good hope from Your Paternity.",
    "kind": "abridged",
    "full_paras": [
     "Some time ago I wrote to Your Paternity of the vocation to the Indies which Our Lord deigned, from the very beginning of my entrance into Religion, to give me, and of its effect I obtained good hope from Your Paternity. Now I write anew, both to remind Your Paternity of it and to supplicate you anew, seeing that God calls me thither, by preserving the vocation in me and by having preserved me amid so many dangers of the plague, in which I was at Nice; among which dangers, once finding myself in the public lazaretto with suspicion of the plague, I promised God that, if I came out safe, I would dedicate myself wholly to His service in the Indies, and to the Most Holy Virgin that I would go to visit her at Loreto; for this reason, the time not being oppo