  "skills": [],
  "health": null,
  "assignment": null,
  "destination": "east-indies",
  "dossier": "Wrote 1 letter from Rome (Collegio Romano) (1616) petitioning the General for the foreign missions; requested destination: East Indies (1).",
  "letters": [
   {
    "n": 6,
    "year": 1616,
    "date": "January 27, 1616",
    "place": "Rome (Collegio Romano)",
    "archival": "ARSI, FG 735, 339",
    "excerpt": "I, Francesco Maria Armillei, most humble servant and son in Christ of Your Most Reverend Paternity, lay before you how for some days now I feel moved and stirred to the vocation of the Indies, not by my merit, but by the grace and favor of the eternal God, who deigned to call me into this His holy Society of Jesus — in whose service I willingly and promptly offer my life and my strength, such as they are, with all indifference, into the hands of Your Paternity; from whom, as from a loving father, I shall await the fulfillment of this my good desire.",
    "kind": "abridged",
    "full_paras": [
     "I, Francesco Maria Armillei, most humble servant and son in Christ of Your Most Reverend Paternity, lay before you how for some days now I feel moved and stirred to the vocation of the Indies, not by my merit, but by the grace and favor of the eternal God, who deigned to call me into this His holy Society of Jesus — in whose service I willingly and promptly offer my life and my strength, such as they are, with all indifference, into the hands of Your Paternity; from whom, as from a loving father, I shall await the fulfillment of this my good desire."
    ]
   }
  ]
 },
 {
  "id": "hist-7",
  "fictional": false,
  "name": "Ignazio Angelucci",
  "author_raw": "Ignazio Angelucci",
  "age": null,
  "yearsInSociety": null,
  "formation": null,
  "studies": null,
  "skills": [],
  "health": null,
  "assignment": null,
  "destination": "east-indies",
  "dossier": "Wrote 1 letter from Sezze (1616) petitioning the General for the foreign missions; requested destination: East Indies (1).",
  "letters": [
   {
    "n": 7,
    "year": 1616,
    "date": "February 3, 1616",
    "place": "Sezze",
    "archival": "ARSI, FG 735, 345",
    "excerpt": "If Your Paternity would grant me this first grace of assigning me either to the Indies or to the North, now that the occasion is present for the one and for the other, it would answer a desire of mine both ancient and great, and I should hope, with the help of the Lord, to do some good. For the love of God, if you judge it best, do not delay the granting. I owe my life to God, who has restored it to me, and I have great reason to hope from Him that He will preserve it for me wherever He calls me; and I owe to spend it and end it willingly wherever He wills.",
    "kind": "abridged",
    "full_paras": [
     "If Your Paternity would grant me this first grace of assigning me either to the Indies or to the North, now that the occasion is present for the one and for the other, it would answer a desire of mine both ancient and great, and I should hope, with the help of the Lord, to do some good. For the love of God, if you judge it best, do not delay the granting. I owe my life to God, who has restored it to me, and I have great reason to hope from Him that He will preserve it for me wherever He calls me; and I owe to spend it and end it willingly wherever He wills. If I were at the feet of Your Paternity, I would tell you such reasons for my hopes of doing some good, and for my spiritual profit in such an assignment, that I see I would certainly obtain the grace. Meanwhile I shall pray God that He inspire Your Paternity to grant it to me, and I await it as granted: quocumque mittas me ibo, ecce ego mitte me (Wherever you send me, I will go: here I am, send me) — and if you will not grant it to me at the prayer of this letter, do me the grace to let me speak to you in person, and for the love of God send me, and bless me."
    ]
   }
  ]
 },
 {
  "id": "hist-8",
