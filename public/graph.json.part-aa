"/letters/3/"}, {"id": "e38", "source": "letter:3", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e39", "source": "letter:3", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e40", "source": "letter:3", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e41", "source": "letter:3", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e42", "source": "letter:3", "target": "person:antoglietta-lelio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e43", "source": "letter:3", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 3, "letter_url": "/letters/3/"}, {"id": "e44", "source": "letter:4", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["for which, my most loving Father, in visceribus Iesu Christi (in the bowels of Jesus Christ), I pray Your Paternity to pardon me and so to act, for your paternal charity, that I may be one of those who expose their lives"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e45", "source": "letter:4", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e46", "source": "letter:4", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e47", "source": "letter:4", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e48", "source": "letter:4", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e49", "source": "letter:4", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e50", "source": "letter:4", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e51", "source": "letter:4", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e52", "source": "letter:4", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["and I promise Your Paternity that in all my labors and in all my actions I shall remember to pray the Lord — though unworthily — to grant Your Paternity such grace that you may govern in the same way as our blessed Rever"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e53", "source": "letter:4", "target": "place:messina", "type": "mentions_place", "label": "mentions", "evidence": ["For the full information of Your Paternity: seven years ago I entered the holy religion, and I have already studied philosophy, and I am now teaching in the 2nd class of the College of Messina, and by the divine grace I "], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e54", "source": "letter:4", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e55", "source": "letter:4", "target": "person:balami-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e56", "source": "letter:4", "target": "place:messina", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 4, "letter_url": "/letters/4/"}, {"id": "e57", "source": "letter:5", "target": "place:east-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Although only a few days ago I wrote to Your Paternity asking leave to go to the East Indies, I have wished anew to remind you, to satisfy in part the great desire I have to obtain this grace, and to kindle myself the mo"], "letter": 5, "letter_url": "/letters/5/"}, {"id": "e58", "source": "letter:5", "target": "place:messina", "type": "mentions_place", "label": "mentions", "evidence": ["Although only a few days ago I wrote to Your Paternity asking leave to go to the East Indies, I have wished anew to remind you, to satisfy in part the great desire I have to obtain this grace, and to kindle myself the mo"], "letter": 5, "letter_url": "/letters/5/"}, {"id": "e59", "source": "letter:5", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 5, "letter_url": "/letters/5/"}, {"id": "e60", "source": "letter:5", "target": "person:baraona-roderico", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 5, "letter_url": "/letters/5/"}, {"id": "e61", "source": "letter:5", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 5, "letter_url": "/letters/5/"}, {"id": "e62", "source": "letter:6", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I, Francesco Maria Armillei, most humble servant and son in Christ of Your Most Reverend Paternity, lay before you how for some days now I feel moved and stirred to the vocation of the Indies, not by my merit, but by the"], "letter": 6, "letter_url": "/letters/6/"}, {"id": "e63", "source": "letter:6", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 6, "letter_url": "/letters/6/"}, {"id": "e64", "source": "letter:6", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 6, "letter_url": "/letters/6/"}, {"id": "e65", "source": "letter:6", "target": "person:armillei-francesco-maria", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 6, "letter_url": "/letters/6/"}, {"id": "e66", "source": "letter:6", "target": "place:rome", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 6, "letter_url": "/letters/6/"}, {"id": "e67", "source": "letter:7", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["If Your Paternity would grant me this first grace of assigning me either to the Indies or to the North, now that the occasion is present for the one and for the other, it would answer a desire of mine both ancient and gr"], "letter": 7, "letter_url": "/letters/7/"}, {"id": "e68", "source": "letter:7", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 7, "letter_url": "/letters/7/"}, {"id": "e69", "source": "letter:7", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 7, "letter_url": "/letters/7/"}, {"id": "e70", "source": "letter:7", "target": "person:angelucci-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 7, "letter_url": "/letters/7/"}, {"id": "e71", "source": "letter:7", "target": "place:sezze", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 7, "letter_url": "/letters/7/"}, {"id": "e72", "source": "letter:8", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote to Father Claudio, of happy memory, of a desire which the Lord had given me to spend even my life in the help of souls in the Indies."], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e73", "source": "letter:8", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e74", "source": "letter:8", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e75", "source": "letter:8", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e76", "source": "letter:8", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e77", "source": "letter:8", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e78", "source": "letter:8", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 8, "letter_url": "/letters/8/"}, {"id": "e79", "source": "letter:9", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 9, "letter_url": "/letters/9/"}, {"id": "e80", "source": "letter:9", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 9, "letter_url": "/letters/9/"}, {"id": "e81", "source": "letter:9", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 9, "letter_url": "/letters/9/"}, {"id": "e82", "source": "letter:9", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 9, "letter_url": "/letters/9/"}, {"id": "e83", "source": "letter:9", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 9, "letter_url": "/letters/9/"}, {"id": "e84", "source": "letter:10", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["and if Your Paternity wishes that I make a vow of it, I make it now: if I cannot serve otherwise, to spend my life in teaching the Indian children the necessary things."], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e85", "source": "letter:10", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e86", "source": "letter:10", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e87", "source": "letter:10", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e88", "source": "letter:10", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e89", "source": "letter:10", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e90", "source": "letter:10", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 10, "letter_url": "/letters/10/"}, {"id": "e91", "source": "letter:11", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e92", "source": "letter:11", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e93", "source": "letter:11", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e94", "source": "letter:11", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e95", "source": "letter:11", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e96", "source": "letter:11", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e97", "source": "letter:11", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["Let Your Paternity know that in all my labors I shall never forget to pray the Lord, unworthily to be sure, that He grant you those graces which are needful for a Father General of the Company of Jesus, so that Your Pate"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e98", "source": "letter:11", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e99", "source": "letter:11", "target": "person:balami-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e100", "source": "letter:11", "target": "place:messina", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 11, "letter_url": "/letters/11/"}, {"id": "e101", "source": "letter:12", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote to Your Paternity, as it was already long ago, that the Lord had opened wide the kind hand of His mercies over me, a miserable one, in calling me to preach His most holy name among the infidels and barbarians, fo"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e102", "source": "letter:12", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e103", "source": "letter:12", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e104", "source": "letter:12", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e105", "source": "letter:12", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e106", "source": "letter:12", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e107", "source": "letter:12", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e108", "source": "letter:12", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["And having nothing else to add, I place myself in the hands and at the feet of Your Paternity (fiat voluntas Dei (may God's will be done)), making you my most humble reverence, and praying the Lord to give you abundance "], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e109", "source": "letter:12", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e110", "source": "letter:12", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e111", "source": "letter:12", "target": "place:nola", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 12, "letter_url": "/letters/12/"}, {"id": "e112", "source": "letter:13", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Since this is the greatest business I can have in this life, I write to Your Paternity, praying you for love of Jesus to console me in this one thing alone — that is, in sending me to the Indies, as I have written severa"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e113", "source": "letter:13", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e114", "source": "letter:13", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e115", "source": "letter:13", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["with this I make you reverence, praying you every happiness from Heaven, from the College of Naples, the 4th of March 1616."], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e116", "source": "letter:13", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e117", "source": "letter:13", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e118", "source": "letter:13", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 13, "letter_url": "/letters/13/"}, {"id": "e119", "source": "letter:14", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["In this letter I turn again to remind Your Paternity of what I have treated with Your Paternity at other times, both in person and also in writing — I mean, of my vocation to China or Japan, if it be to the greater glory"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e120", "source": "letter:14", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["In this letter I turn again to remind Your Paternity of what I have treated with Your Paternity at other times, both in person and also in writing — I mean, of my vocation to China or Japan, if it be to the greater glory"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e121", "source": "letter:14", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e122", "source": "letter:14", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e123", "source": "letter:14", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e124", "source": "letter:14", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e125", "source": "letter:14", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e126", "source": "letter:14", "target": "place:italy", "type": "mentions_place", "label": "mentions", "evidence": ["And to this end I have written to our Father Assistants of Italy and of Portugal, one each, that they may aid me with Your Paternity in this matter."], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e127", "source": "letter:14", "target": "place:portugal", "type": "mentions_place", "label": "mentions", "evidence": ["And to this end I have written to our Father Assistants of Italy and of Portugal, one each, that they may aid me with Your Paternity in this matter."], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e128", "source": "letter:14", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["Your Paternity in Rome gave me no small good hope, promising me that doubtless in those parts I would do much service to our Lord God with my painting;"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e129", "source": "letter:14", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e130", "source": "letter:14", "target": "person:ardoino-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e131", "source": "letter:14", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 14, "letter_url": "/letters/14/"}, {"id": "e132", "source": "letter:15", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The reason why until now I have not written to Your Reverence concerning the vocation to the Indies, it being more than five years that I have had this desire, has come partly from a certain vain respect, partly from not", "and that you may more clearly understand my desire: the principal motive that moved me to embrace our Institute was the knowledge of the opportunity there was to go to the Indies."], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e133", "source": "letter:15", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e134", "source": "letter:15", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e135", "source": "letter:15", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e136", "source": "letter:15", "target": "person:balione-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e137", "source": "letter:15", "target": "place:genoa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 15, "letter_url": "/letters/15/"}, {"id": "e138", "source": "letter:16", "target": "place:paraguay", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Now is the time when Your Paternity can fulfill my long desire — either with this mission to Paraguay, if there be some impediment (as I understand) in any of those already chosen, or with those of Father Trigault."], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e139", "source": "letter:16", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wish to console you with these missions, both for having written to you several times, and for having been among the first to ask Your Paternity to go to the Indies;"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e140", "source": "letter:16", "target": "topic:paraguay-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e141", "source": "letter:16", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e142", "source": "letter:16", "target": "person:trigault-nicolas", "type": "mentions_person", "label": "mentions", "evidence": ["Now is the time when Your Paternity can fulfill my long desire — either with this mission to Paraguay, if there be some impediment (as I understand) in any of those already chosen, or with those of Father Trigault."], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e143", "source": "letter:16", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e144", "source": "letter:16", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e145", "source": "letter:16", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 16, "letter_url": "/letters/16/"}, {"id": "e146", "source": "letter:17", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Now is the time when Your Paternity may remember me, as you have answered me so many times that you wished to do when the occasion arose — that is, by fulfilling my long and great desire for the Indies."], "letter": 17, "letter_url": "/letters/17/"}, {"id": "e147", "source": "letter:17", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 17, "letter_url": "/letters/17/"}, {"id": "e148", "source": "letter:17", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 17, "letter_url": "/letters/17/"}, {"id": "e149", "source": "letter:17", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 17, "letter_url": "/letters/17/"}, {"id": "e150", "source": "letter:17", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 17, "letter_url": "/letters/17/"}, {"id": "e151", "source": "letter:18", "target": "place:paraguay", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Let Your Paternity not doubt that I meanwhile shall forget this so signal a favor and gift — namely, to have been made, beyond all my merit, one of the heralds of the greatness of God to the Paraguayans, by means of Your"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e152", "source": "letter:18", "target": "topic:paraguay-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e153", "source": "letter:18", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e154", "source": "letter:18", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["From the College of Naples, April 29, 1616."], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e155", "source": "letter:18", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e156", "source": "letter:18", "target": "person:comentali-pietro", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e157", "source": "letter:18", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 18, "letter_url": "/letters/18/"}, {"id": "e158", "source": "letter:19", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e159", "source": "letter:19", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e160", "source": "letter:19", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e161", "source": "letter:19", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e162", "source": "letter:19", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["and I shall never forget to pray the Lord that He grant you so much spirit and grace that you may be another Blessed Father Ignatius."], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e163", "source": "letter:19", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 19, "letter_url": "/letters/19/"}, {"id": "e164", "source": "letter:19", "target": "person:balami-ignazio", "type": "written_b