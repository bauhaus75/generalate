": ["addressed"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1175", "source": "letter:135", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1176", "source": "letter:135", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 135, "letter_url": "/letters/135/"}, {"id": "e1177", "source": "letter:136", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1178", "source": "letter:136", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I know full well that I trouble Your Paternity with my many letters, but trusting in your fatherly charity, and urged by the ardent desire I feel to go to those parts of the Indies where my heart is, I cannot do otherwis"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1179", "source": "letter:136", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1180", "source": "letter:136", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1181", "source": "letter:136", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1182", "source": "letter:136", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1183", "source": "letter:136", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["I know for certain that I would be consoled by obtaining that which now, and in these times with the coming of the Father Procurator of China, keeps me on tenterhooks, and all the day makes me sigh, and count the moments"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1184", "source": "letter:136", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["O Our Father, how many times a day do I wish I were a bird, that flying I might transport myself to Rome to speak with Your Paternity, and plead my cause face to face!"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1185", "source": "letter:136", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1186", "source": "letter:136", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1187", "source": "letter:136", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 136, "letter_url": "/letters/136/"}, {"id": "e1188", "source": "letter:137", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The desire that by the grace of the Lord I have to go to those parts of the Infidels, and the double vow I have made to go to the Indies and to ask for the passage with every ardor, compel me to give Your Paternity frequ"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1189", "source": "letter:137", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1190", "source": "letter:137", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1191", "source": "letter:137", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1192", "source": "letter:137", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1193", "source": "letter:137", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["O that I were in Rome!"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1194", "source": "letter:137", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1195", "source": "letter:137", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1196", "source": "letter:137", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 137, "letter_url": "/letters/137/"}, {"id": "e1197", "source": "letter:138", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1198", "source": "letter:138", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1199", "source": "letter:138", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1200", "source": "letter:138", "target": "person:semedo-alvaro", "type": "mentions_person", "label": "mentions", "evidence": ["and for the love he bears to the Most Holy Virgin — on the vigil of whose nativity I write this present — grant me this one consolation: to send me with Father Alvaro Semedo to those parts;"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1201", "source": "letter:138", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1202", "source": "letter:138", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1203", "source": "letter:138", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 138, "letter_url": "/letters/138/"}, {"id": "e1204", "source": "letter:139", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I have shown myself perhaps a little cold in writing, and in making new petitions to Your Paternity to obtain the grace of the Indies, because it seemed there was no certainty of the Mission;"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1205", "source": "letter:139", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1206", "source": "letter:139", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1207", "source": "letter:139", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1208", "source": "letter:139", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1209", "source": "letter:139", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 139, "letter_url": "/letters/139/"}, {"id": "e1210", "source": "letter:140", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["and with humble prayers I ask of Your Paternity nothing else but to go and suffer, and to labor in those parts of the Indies, where the Lord calls me through His infinite mercy."], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1211", "source": "letter:140", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1212", "source": "letter:140", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1213", "source": "letter:140", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1214", "source": "letter:140", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1215", "source": "letter:140", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 140, "letter_url": "/letters/140/"}, {"id": "e1216", "source": "letter:141", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I would be most perplexed and doubtful over the annoyance I cause Your Paternity with my letters, were it not that your paternal charity takes away all my fear — charity which I know for certain is not wearied by the imp"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1217", "source": "letter:141", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1218", "source": "letter:141", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1219", "source": "letter:141", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1220", "source": "letter:141", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1221", "source": "letter:141", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1222", "source": "letter:141", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1223", "source": "letter:141", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1224", "source": "letter:141", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["And just as a poor man asking alms for the Blood of Jesus and for the love of the Virgin is not refused, in the same way Your Paternity must not refuse me, who humbly and prostrate on the ground ask him for the Indies as"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1225", "source": "letter:141", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1226", "source": "letter:141", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1227", "source": "letter:141", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 141, "letter_url": "/letters/141/"}, {"id": "e1228", "source": "letter:142", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I return to making my usual petitions for the Indies, and I renew the tears that I have shed in so many other letters;"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1229", "source": "letter:142", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1230", "source": "letter:142", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1231", "source": "letter:142", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1232", "source": "letter:142", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1233", "source": "letter:142", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 142, "letter_url": "/letters/142/"}, {"id": "e1234", "source": "letter:143", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["But I hope in the divine goodness and in the paternal charity of Your Paternity that I shall be consoled by being assigned as slave to those who shall go to China."], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1235", "source": "letter:143", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I write anew to Your Paternity, but I would that this letter were written in my own blood, so that it might the better and more readily obtain from Your Paternity the longed-for grace of going to the desired Indies."], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1236", "source": "letter:143", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1237", "source": "letter:143", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1238", "source": "letter:143", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1239", "source": "letter:143", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1240", "source": "letter:143", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1241", "source": "letter:143", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1242", "source": "letter:143", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1243", "source": "letter:143", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 143, "letter_url": "/letters/143/"}, {"id": "e1244", "source": "letter:144", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I know for certain that Your Paternity, moved to pity for me, a poor wretch burning with desire, would grant me the longed-for grace for the desired China."], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1245", "source": "letter:144", "target": "topic:angels", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1246", "source": "letter:144", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1247", "source": "letter:144", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1248", "source": "letter:144", "target": "topic:gonzaga-st-aloysius", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1249", "source": "letter:144", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1250", "source": "letter:144", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1251", "source": "letter:144", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1252", "source": "letter:144", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1253", "source": "letter:144", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1254", "source": "letter:144", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1255", "source": "letter:144", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1256", "source": "letter:144", "target": "person:gonzaga-aloysius", "type": "mentions_person", "label": "mentions", "evidence": ["Yes, yes, Our Father, grant it to me for the love you bear the Most Holy Blood of Christ and the Most Holy Virgin, Saint Ignatius, Saint Francis Xavier, Blessed Aloysius, and his Guardian Angel;"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1257", "source": "letter:144", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["Yes, yes, Our Father, grant it to me for the love you bear the Most Holy Blood of Christ and the Most Holy Virgin, Saint Ignatius, Saint Francis Xavier, Blessed Aloysius, and his Guardian Angel;"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1258", "source": "letter:144", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Yes, yes, Our Father, grant it to me for the love you bear the Most Holy Blood of Christ and the Most Holy Virgin, Saint Ignatius, Saint Francis Xavier, Blessed Aloysius, and his Guardian Angel;"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1259", "source": "letter:144", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["I hear that some have already been notified for China — and what sentiments has the news of them not stirred within my soul!"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1260", "source": "letter:144", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1261", "source": "letter:144", "target": "person:spinelli-luigi", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1262", "source": "letter:144", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 144, "letter_url": "/letters/144/"}, {"id": "e1263", "source": "letter:145", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["That I should not go to the Indies?"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1264", "source": "letter:145", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1265", "source": "letter:145", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1266", "source": "letter:145", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1267", "source": "letter:145", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1268", "source": "letter:145", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 145, "letter_url": "/letters/145/"}, {"id": "e1269", "source": "letter:146", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["It matters greatly to me, for obtaining my longed-for Mission of Japan, or China, to clarify anew and more distinctly to Your Paternity how my vocation to the Indies has always been for Japan, or China, and not for the o", "for, this having been pointed out to me by many, to remove the equivocation I have asked explicitly for Japan, or China, and so I have been accustomed to write to the Father Assistant of Portugal, and to Father Alvaro Se"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1270", "source": "letter:146", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["It matters greatly to me, for obtaining my longed-for Mission of Japan, or China, to clarify anew and more distinctly to Your Paternity how my vocation to the Indies has always been for Japan, or China, and not for the o", "for, this having been pointed out to me by many, to remove the equivocation I have asked explicitly for Japan, or China, and so I have been accustomed to write to the Father Assistant of Portugal, and to Father Alvaro Se"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1271", "source": "letter:146", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["It matters greatly to me, for obtaining my longed-for Mission of Japan, or China, to clarify anew and more distinctly to Your Paternity how my vocation to the Indies has always been for Japan, or China, and not for the o"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1272", "source": "letter:146", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1273", "source": "letter:146", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1274", "source": "letter:146", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1275", "source": "letter:146", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1276", "source": "letter:146", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1277", "source": "letter:146", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1278", "source": "letter:146", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1279", "source": "letter:146", "target": "topic:philippines-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1280", "source": "letter:146", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1281", "source": "letter:146", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1282", "source": "letter:146", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1283", "source": "letter:146", "target": "person:semedo-alvaro", "type": "mentions_person", "label": "mentions", "evidence": ["for, this having been pointed out to me by many, to remove the equivocation I have asked explicitly for Japan, or China, and so I have been accustomed to write to the Father Assistant of Portugal, and to Father Alvaro Se"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1284", "source": "letter:146", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["for, this having been pointed out to me by many, to remove the equivocation I have asked explicitly for Japan, or China, and so I have been accustomed to write to the Father Assistant of Portugal, and to Father Alvaro Se", "And already I was all ready to depart, although [hidden from me] the Call from Your Paternity were for the Philippines, or Japan and China — thinking I, and many others, that one Mission had been confused for the other —"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1285", "source": "letter:146", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["And already I was all ready to depart, although [hidden from me] the Call from Your Paternity were for the Philippines, or Japan and China — thinking I, and many others, that one Mission had been confused for the other —"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1286", "source": "letter:146", "target": "place:philippines", "type": "mentions_place", "label": "mentions", "evidence": ["I go mad thinking that the Lord has mortified me in having offered me the Philippines, for which I have declared I have no vocation;", "nor have I ever wished to write to the Father Procurator of the Philippines."], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1287", "source": "letter:146", "target": "place:portugal", "type": "mentions_place", "label": "mentions", "evidence": ["for, this having been pointed out to me by many, to remove the equivocation I have asked explicitly for Japan, or China, and so I have been accustomed to write to the Father Assistant of Portugal, and to Father Alvaro Se"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1288", "source": "letter:146", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1289", "source": "letter:146", "target": "person:finechiaro-mario", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1290", "source": "letter:146", "target": "place:caltanissetta", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 146, "letter_url": "/letters/146/"}, {"id": "e1291", "source": "letter:147", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1292", "source": "letter:147", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1293", "source": "letter:147", "target": "place:spain", "type": "mentions_place", "label": "mentions", "evidence": ["The Father Assistant of Spain in a reply of his tells me that the Father Procurator come hither from the West Indies does not want, nor will bring with him, subjects;"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1294", "source": "letter:147", "target": "place:west-indies", "type": "mentions_place", "label": "mentions", "evidence": ["The Father Assistant of Spain in a reply of his tells me that the Father Procurator come hither from the West Indies does not want, nor will bring with him, subjects;"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1295", "source": "letter:147", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1296", "source": "letter:147", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1297", "source": "letter:147", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 147, "letter_url": "/letters/147/"}, {"id": "e1298", "source": "letter:148", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 148, "letter_url": "/letters/148/"}, {"id": "e1299", "source": "letter:148", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 148, "letter_url": "/letters/148/"}, {"id": "e1300", "source": "letter:148", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 148, "letter_url": "/letters/148/"}, {"id": "e1301", "source": "letter:148", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 148, "letter_url": "/letters/148/"}, {"id": "e1302", "source": "letter:149", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1303", "source": "letter:149", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1304", "source": "letter:149", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["From that of Your Paternity I understood that for now there was no occasion to send workmen to the Indies, and therefore there was need more of prayers than of multiplying letters."], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1305", "source": "letter:149", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1306", "source": "letter:149", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1307", "source": "letter:149", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 149, "letter_url": "/letters/149/"}, {"id": "e1308", "source": "letter:150", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 150, "letter_url": "/letters/150/"}, {"id": "e1309", "source": "letter:150", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 150, "letter_url": "/letters/150/"}, {"id": "e1310", "source": "letter:150", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 150, "letter_url": "/letters/150/"}, {"id": "e1311", "source": "letter:150", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 150, "letter_url": "/letters/150/"}, {"id": "e1312", "source": "letter:150", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 150, "letter_url": "/letters/150/"}, {"id": "e1313", "source": "letter:151", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I have heard from some letters that have come from your quarters that it will not be long before Your Paternity sends some men to the Indies."], "letter": 151, "letter_url": "/letters/151/"}, {"id": "e1314", "source": "letter:151", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 151, "letter_url": "/letters/151/"}, {"id": "e1315", "source": "letter:151", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 151, "letter_url": "/letters/151/"}, {"id": "e1316", "source": "letter:151", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 151, "letter_url": "/letters/151/"}, {"id": "e1317", "source": "letter:151", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 151, "letter_url": "/letters/151/"}, {"id": "e1318", "source": "letter:152", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["From Father Provincial I received news that Your Paternity had written me into the book of those who ask to go to the Indies;"], "letter": 152, "letter_url": "/letters/152/"}, {"id": "e1319", "source": "letter:152", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 152, "letter_url": "/letters/152/"}, {"id": "e1320", "source": "letter:152", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 152, "letter_url": "/letters/152/"}, {"id": "e1321", "source": "letter:152", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 152, "letter_url": "/letters/152/"}, {"id": "e1322", "source": "letter:152", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 152, "letter_url": "/letters/152/"}, {"id": "e1323", "source": "letter:153", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["If I have let two posts pass without writing to Your Paternity begging to be sent to the Indies, the cause has not been that my desire is less alive now than before;"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1324", "source": "letter:153", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1325", "source": "letter:153", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1326", "source": "letter:153", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1327", "source": "letter:153", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1328", "source": "letter:153", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 153, "letter_url": "/letters/153/"}, {"id": "e1329", "source": "letter:154", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I humbly thank Your Paternity for the remembrance he keeps of me in his letters to my Father Rector and Father Provincial, but I would that he also remember to console me as soon as possible by sending me to the Indies I"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1330", "source": "letter:154", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1331", "source": "letter:154", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1332", "source": "letter:154", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["Gladly, if it pleased Your Paternity, I would change places with someone from the Province of Naples — not for any other reason but that I would find myself readier, and on occasion more prompt to carry out whatever migh"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1333", "source": "letter:154", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1334", "source": "letter:154", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1335", "source": "letter:154", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 154, "letter_url": "/letters/154/"}, {"id": "e1336", "source": "letter:155", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 155, "letter_url": "/letters/155/"}, {"id": "e1337", "source": "letter:155", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 155, "letter_url": "/letters/155/"}, {"id": "e1338", "source": "letter:155", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 155, "letter_url": "/letters/155/"}, {"id": "e1339", "source": "letter:155", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 155, "letter_url": "/letters/155/"}, {"id": "e1340", "source": "letter:156", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["if Your Paternity knew the immense desire I have in my breast for this mission to the Indies, he would certainly send me at once."], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1341", "source": "letter:156", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1342", "source": "letter:156", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1343", "source": "letter:156", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1344", "source": "letter:156", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1345", "source": "letter:156", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 156, "letter_url": "/letters/156/"}, {"id": "e1346", "source": "letter:157", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'Japan, mission to' (printed)"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1347", "source": "letter:157", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1348", "source": "letter:157", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1349", "source": "letter:157", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["If my sins were not what they are, without doubt the Lord God would have by this hour disposed things so that Your Paternity would soon send more workers than one from Sicily, and I would not stand here with this envy — "], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1350", "source": "letter:157", "target": "place:sicily", "type": "mentions_place", "label": "mentions", "evidence": ["If my sins were not what they are, without doubt the Lord God would have by this hour disposed things so that Your Paternity would soon send more workers than one from Sicily, and I would not stand here with this envy — "], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1351", "source": "letter:157", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1352", "source": "letter:157", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1353", "source": "letter:157", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 157, "letter_url": "/letters/157/"}, {"id": "e1354", "source": "letter:158", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Until now I have lived, as the saying goes, on hope, believing that this year I should be consoled by Your Paternity and sent to my Indies;"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1355", "source": "letter:158", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1356", "source": "letter:158", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1357", "source": "letter:158", "target": "topic:spiritual-exercises", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1358", "source": "letter:158", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1359", "source": "letter:158", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1360", "source": "letter:158", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 158, "letter_url": "/letters/158/"}, {"id": "e1361", "source": "letter:159", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["On this day, on which the Redeemer of the world offered Himself in a most perfect holocaust to the eternal Father for my sake, I resolve at last to offer myself as a holocaust too, for love of the same Lord, into the han"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1362", "source": "letter:159", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["On this day, on which the Redeemer of the world offered Himself in a most perfect holocaust to the eternal Father for my sake, I resolve at last to offer myself as a holocaust too, for love of the same Lord, into the han", "But a stronger impulse has been added to me in these days by hearing, from a letter from the Indies transmitted to a scholastic of this College, of the scarcity of workers to cultivate that new vineyard, nay to gather th"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1363", "source": "letter:159", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1364", "source": "letter:159", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1365", "source": "letter:159", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1366", "source": "letter:159", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1367", "source": "letter:159", "target": "person:berni-sebastiano", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1368", "source": "letter:159", "target": "place:bologna", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 159, "letter_url": "/letters/159/"}, {"id": "e1369", "source": "letter:160", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 160, "letter_url": "/letters/160/"}, {"id": "e1370", "source": "letter:160", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 160, "letter_url": "/letters/160/"}, {"id": "e1371", "source": "letter:160", "target": "person:lazari-giacomo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 160, "letter_url": "/letters/160/"}, {"id": "e1372", "source": "letter:160", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 160, "letter_url": "/letters/160/"}, {"id": "e1373", "source": "letter:161", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["To compress into little the much that I must most humbly lay before Your Paternity concerning my vocation to the Indies, I say with all truth that it has lasted the space of twelve continuous years that I have unworthily", "To this is added that I have weighed well all the difficulties that might draw me back, but they have served only to confirm me all the more in my resolve — indeed, in the vow lately made with Your Paternity's approval —"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1374", "source": "letter:161", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1375", "source": "letter:161", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1376", "source": "letter:161", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1377", "source": "letter:161", "target": "topic:other-missions", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1378", "source": "letter:161", "target": "topic:spiritual-exercises", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1379", "source": "letter:161", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1380", "source": "letter:161", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1381", "source": "letter:161", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1382", "source": "letter:161", "target": "place:ethiopia", "type": "mentions_place", "label": "mentions", "evidence": ["of which I feel intensely assured, with particular consolation and certain hope of obtaining the grace from Your Paternity in the present occasion of the coming of the Father Procurator of Ethiopia, to whom I have offere"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1383", "source": "letter:161", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1384", "source": "letter:161", "target": "person:serafini-fortunato", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1385", "source": "letter:161", "target": "place:rome", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 161, "letter_url": "/letters/161/"}, {"id": "e1386", "source": "letter:162", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["May Our Lord grant Your Paternity long life for His glory, and to me only as much as will let me reach the Indies and shed my blood for the faith."], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1387", "source": "letter:162", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1388", "source": "letter:162", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1389", "source": "letter:162", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1390", "source": "letter:162", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1391", "source": "letter:162", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["After so many petitions made through all the years I have been in the Company, I now begin to renew them on the occasion of the coming of the Father Procurator of the Indies, Father Francesco Carvaglio."], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1392", "source": "letter:162", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1393", "source": "letter:162", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1394", "source": "letter:162", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 162, "letter_url": "/letters/162/"}, {"id": "e1395", "source": "letter:163", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I return to make known to Your Paternity my supreme and only desire for the Indies, for I know that shortly Your Paternity will make the most fortunate choice of subjects for that most glorious Mission."], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1396", "source": "letter:163", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1397", "source": "letter:163", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1398", "source": "letter:163", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1399", "source": "letter:163", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1400", "source": "letter:163", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1401", "source": "letter:163", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1402", "source": "letter:163", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 163, "letter_url": "/letters/163/"}, {"id": "e1403", "source": "letter:164", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["If ever my soul tasted true gladness, it was then when, by Your Paternity's reply received through the Father Rector, I conceived a sure hope that I too must one day follow in the footsteps of those who labor with such z"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1404", "source": "letter:164", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1405", "source": "letter:164", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1406", "source": "letter:164", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1407", "source": "letter:164", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Already into your hands now (I have already done so many times into the hands of St. Francis Xavier) I renounce Italy, my homeland, and all that might delay my going."], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1408", "source": "letter:164", "target": "place:italy", "type": "mentions_place", "label": "mentions", "evidence": ["Francis Xavier) I renounce Italy, my homeland, and all that might delay my going."], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1409", "source": "letter:164", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1410", "source": "letter:164", "target": "person:berni-sebastiano", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1411", "source": "letter:164", "target": "place:bologna", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 164, "letter_url": "/letters/164/"}, {"id": "e1412", "source": "letter:165", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Francis, with the Indies he has given me, the spirit of an Indian."], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1413", "source": "letter:165", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1414", "source": "letter:165", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1415", "source": "letter:165", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1416", "source": "letter:165", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1417", "source": "letter:165", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1418", "source": "letter:165", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["It was only the benignity of Your Paternity, and my most holy Father and Apostle of the Indies, St. Francis Xavier, who held in his hands the keys of the treasures of Heaven and opened them and made this great prodigalit", "In closing I beg you to give me your blessing and to obtain for me from my Protector St. Francis, with the Indies he has given me, the spirit of an Indian."], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1419", "source": "letter:165", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["It was only the benignity of Your Paternity, and my most holy Father and Apostle of the Indies, St."], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1420", "source": "letter:165", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1421", "source": "letter:165", "target": "person:cinami-leonardo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1422", "source": "letter:165", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 165, "letter_url": "/letters/165/"}, {"id": "e1423", "source": "letter:166", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Therefore, seeing no better way in which I may in some part acknowledge His mercies than by delivering myself wholly to the same One of whom I am wholly, I make in the hands of Your Paternity a holocaust for this Mission"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1424", "source": "letter:166", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1425", "source": "letter:166", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1426", "source": "letter:166", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1427", "source": "letter:166", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1428", "source": "letter:166", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1429", "source": "letter:166", "target": "person:berni-sebastiano", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1430", "source": "letter:166", "target": "place:bologna", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 166, "letter_url": "/letters/166/"}, {"id": "e1431", "source": "letter:167", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["In closing I humbly ask your paternal blessing as sure pledge and earnest of the desired Mission."], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1432", "source": "letter:167", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1433", "source": "letter:167", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1434", "source": "letter:167", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1435", "source": "letter:167", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1436", "source": "letter:167", "target": "person:berni-sebastiano", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1437", "source": "letter:167", "target": "place:bologna", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 167, "letter_url": "/letters/167/"}, {"id": "e1438", "source": "letter:168", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Although, as I have many times repeated to you, I shall always be more than content with whatever Your Paternity shall ordain of me, nevertheless knowing that without prejudice to such indifference one may make proposals"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1439", "source": "letter:168", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1440", "source": "letter:168", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1441", "source": "letter:168", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1442", "source": "letter:168", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1443", "source": "letter:168", "target": "person:berni-sebastiano", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1444", "source": "letter:168", "target": "place:bologna", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 168, "letter_url": "/letters/168/"}, {"id": "e1445", "source": "letter:169", "target": "place:chile", "type": "aspires_to", "label": "desires to travel to", "evidence": ["but to better obtain the license, I pray Your Paternity to grant me to go to Chile."], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1446", "source": "letter:169", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'Japan, mission to' (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1447", "source": "letter:169", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1448", "source": "letter:169", "target": "topic:gonzaga-st-aloysius", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1449", "source": "letter:169", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1450", "source": "letter:169", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1451", "source": "letter:169", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1452", "source": "letter:169", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1453", "source": "letter:169", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1454", "source": "letter:169", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1455", "source": "letter:169", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1456", "source": "letter:169", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1457", "source": "letter:169", "target": "person:gonzaga-aloysius", "type": "mentions_person", "label": "mentions", "evidence": ["Heaven willed that barely five months had passed when, my former health being confirmed, I made, on the day of Blessed Aloysius three years ago, the vows."], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1458", "source": "letter:169", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["I had recourse to my St. Francis, promising to follow him if he would grant me health;", "but in case I were not heard, I would pray — but I hope in the charity of Your Paternity and in my St. Francis that I shall obtain the grace I desire — not to speak of it with any person."], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1459", "source": "letter:169", "target": "place:chile", "type": "mentions_place", "label": "mentions", "evidence": ["but with the occasion that so many go to spend their labors, some to Chile, some to Japan — and would God that among these my name might be read — it has grown so that without uncovering it, it would cause no small distr"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1460", "source": "letter:169", "target": "place:genoa", "type": "mentions_place", "label": "mentions", "evidence": ["Having suffered much in the novitiate, and this, as I believe, being caused by the change of air from Milan to that of Genoa, they came to the opinion of dismissing me from the Company so beloved by me;"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1461", "source": "letter:169", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["but with the occasion that so many go to spend their labors, some to Chile, some to Japan — and would God that among these my name might be read — it has grown so that without uncovering it, it would cause no small distr"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1462", "source": "letter:169", "target": "place:milan", "type": "mentions_place", "label": "mentions", "evidence": ["Having suffered much in the novitiate, and this, as I believe, being caused by the change of air from Milan to that of Genoa, they came to the opinion of dismissing me from the Company so beloved by me;"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1463", "source": "letter:169", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1464", "source": "letter:169", "target": "person:archinto-giuseppe", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 169, "letter_url": "/letters/169/"}, {"id": "e1465", "source": "letter:169", "target": "place:milan", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 169, "letter_url": "/letters/169/"}], "type_labels": {"written_by": "written by", "written_in": "written in", "recipient": "addressed to", "mentions_person": "mentions", "mentions_place": "mentions", "aspires_to": "desires to travel to", "indexed_under": "indexed under"}}