 "Virgin Mary", "sub": "theme", "url": "/topics/virgin-mary/", "n_letters": 35}, {"id": "topic:vows", "kind": "topic", "label": "Vows", "sub": "theme", "url": "/topics/vows/", "n_letters": 19}, {"id": "topic:xavier-st-francis", "kind": "topic", "label": "Xavier, St. Francis", "sub": "theme", "url": "/topics/xavier-st-francis/", "n_letters": 14}, {"id": "topic:zeal-for-souls", "kind": "topic", "label": "Zeal for souls", "sub": "theme", "url": "/topics/zeal-for-souls/", "n_letters": 71}], "edges": [{"id": "e0", "source": "letter:1", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote, while the happy memory of our Father Claudio Acquaviva was still alive, to that Father, asking leave to go to the Indies;"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e1", "source": "letter:1", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e2", "source": "letter:1", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e3", "source": "letter:1", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e4", "source": "letter:1", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e5", "source": "letter:1", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e6", "source": "letter:1", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e7", "source": "letter:1", "target": "person:acquaviva-claudio", "type": "mentions_person", "label": "mentions", "evidence": ["I wrote, while the happy memory of our Father Claudio Acquaviva was still alive, to that Father, asking leave to go to the Indies;"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e8", "source": "letter:1", "target": "place:east-indies", "type": "mentions_place", "label": "mentions", "evidence": ["and I assure Your Paternity,Coram Domino (before the Lord), that no greater consolation in this life could I receive than this — to go to those blessed and happy parts of the East Indies, if it so please Your Paternity, "], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e9", "source": "letter:1", "target": "place:italy", "type": "mentions_place", "label": "mentions", "evidence": ["although, as for me, I should esteem myself most happy to be able to leave this Italy, already odious to me for my desire for those parts."], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e10", "source": "letter:1", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e11", "source": "letter:1", "target": "person:astria-giovanni-battista", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e12", "source": "letter:1", "target": "place:genoa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 1, "letter_url": "/letters/1/"}, {"id": "e13", "source": "letter:2", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["dispose of me as shall most please you, for I should esteem myself most happy to be able to depart once from this Italy with these Father Procurators — of China or of Japan — this Italy which I hold almost in hatred for "], "letter": 2, "letter_url": "/letters/2/"}, {"