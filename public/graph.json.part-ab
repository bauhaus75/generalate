_url": "/letters/24/"}, {"id": "e214", "source": "letter:24", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 24, "letter_url": "/letters/24/"}, {"id": "e215", "source": "letter:24", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 24, "letter_url": "/letters/24/"}, {"id": "e216", "source": "letter:24", "target": "person:stella-marco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 24, "letter_url": "/letters/24/"}, {"id": "e217", "source": "letter:24", "target": "place:sicily", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 24, "letter_url": "/letters/24/"}, {"id": "e218", "source": "letter:25", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e219", "source": "letter:25", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e220", "source": "letter:25", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e221", "source": "letter:25", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e222", "source": "letter:25", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e223", "source": "letter:25", "target": "place:east-indies", "type": "mentions_place", "label": "mentions", "evidence": ["I do not ask for the East Indies nor the West Indies, except where Your Paternity, guided by the Holy Spirit, shall judge that I may suffer much [and much];"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e224", "source": "letter:25", "target": "place:west-indies", "type": "mentions_place", "label": "mentions", "evidence": ["I do not ask for the East Indies nor the West Indies, except where Your Paternity, guided by the Holy Spirit, shall judge that I may suffer much [and much];"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e225", "source": "letter:25", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e226", "source": "letter:25", "target": "person:balami-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e227", "source": "letter:25", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 25, "letter_url": "/letters/25/"}, {"id": "e228", "source": "letter:26", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Most beloved Father: for the space of two years I have been held in a great desire to go toward the kingdom of China;"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e229", "source": "letter:26", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e230", "source": "letter:26", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e231", "source": "letter:26", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e232", "source": "letter:26", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e233", "source": "letter:26", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e234", "source": "letter:26", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e235", "source": "letter:26", "target": "place:ferrara", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 26, "letter_url": "/letters/26/"}, {"id": "e236", "source": "letter:27", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Seeing the time approach when there is hope that missions to the Indies may be made, I am compelled by the desire to be one of those who shall be sent to those happy parts — I am compelled, I say, to refresh Your Paterni"], "letter": 27, "letter_url": "/letters/27/"}, {"id": "e237", "source": "letter:27", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 27, "letter_url": "/letters/27/"}, {"id": "e238", "source": "letter:27", "target": "person:fassari-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 27, "letter_url": "/letters/27/"}, {"id": "e239", "source": "letter:27", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 27, "letter_url": "/letters/27/"}, {"id": "e240", "source": "letter:28", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Because blessed God does not fail, with His infinite mercy, as He has deigned to give me this holy desire to go to the Indies, so also to keep it in me, indeed to increase it ever more, giving me great hope of one day en"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e241", "source": "letter:28", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e242", "source": "letter:28", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e243", "source": "letter:28", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e244", "source": "letter:28", "target": "person:gargano-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e245", "source": "letter:28", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 28, "letter_url": "/letters/28/"}, {"id": "e246", "source": "letter:29", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I know well that, having ever been assured in this my vocation by so many most just ways through my superiors and spiritual fathers: I was born for the Indies — nor shall anyone take them from me;", "Let Your Paternity now at last let me follow my Captain to the Indies, for it is time."], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e247", "source": "letter:29", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e248", "source": "letter:29", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e249", "source": "letter:29", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e250", "source": "letter:29", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e251", "source": "letter:29", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e252", "source": "letter:29", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e253", "source": "letter:29", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e254", "source": "letter:29", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e255", "source": "letter:29", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e256", "source": "letter:29", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e257", "source": "letter:29", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["Grant it to me for love of the Most Blessed Virgin, for our Holy Father Ignatius, and for all the court of Heaven."], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e258", "source": "letter:29", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e259", "source": "letter:29", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e260", "source": "letter:29", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 29, "letter_url": "/letters/29/"}, {"id": "e261", "source": "letter:30", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'Japan, mission to' (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e262", "source": "letter:30", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["But that thing which I put in it — namely that Your Paternity, if you would not send me now to the Indies, would at least assure me for after philosophy — was most foolish, and ungrateful to God."], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e263", "source": "letter:30", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e264", "source": "letter:30", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e265", "source": "letter:30", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e266", "source": "letter:30", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e267", "source": "letter:30", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e268", "source": "letter:30", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e269", "source": "letter:30", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e270", "source": "letter:30", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["My Father, in the bowels of Jesus Christ: I see (let it be said, as it truly is, with all indifference) — I see, my Father, that now God wants me in the Indies, or in Japan, in so many occasions which Your Paternity know"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e271", "source": "letter:30", "target": "place:the-indies", "type": "mentions_place", "label": "mentions", "evidence": ["My Father, in the bowels of Jesus Christ: I see (let it be said, as it truly is, with all indifference) — I see, my Father, that now God wants me in the Indies, or in Japan, in so many occasions which Your Paternity know"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e272", "source": "letter:30", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e273", "source": "letter:30", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e274", "source": "letter:30", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 30, "letter_url": "/letters/30/"}, {"id": "e275", "source": "letter:31", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Since I entered the Society in particular because I understood that from there I could easily pass to the Indies to cooperate in some measure in the helping of those souls, and since that desire has grown day by day with", "Now, since Your Paternity has deigned with a letter to encourage us to perfection, and especially to the help and winning of the souls of the Indies, I offer myself most promptly, if you so judge, to serve those good Fat"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e276", "source": "letter:31", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e277", "source": "letter:31", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e278", "source": "letter:31", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e279", "source": "letter:31", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e280", "source": "letter:31", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e281", "source": "letter:31", "target": "person:asiano-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e282", "source": "letter:31", "target": "place:bari", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 31, "letter_url": "/letters/31/"}, {"id": "e283", "source": "letter:32", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Every greeting from these Fathers, given me on behalf of Your Paternity, kindles and inflames my heart the more to ask Your Paternity with greater insistence for the Indies I so desire;"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e284", "source": "letter:32", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e285", "source": "letter:32", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e286", "source": "letter:32", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e287", "source": "letter:32", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e288", "source": "letter:32", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e289", "source": "letter:32", "target": "person:fassari-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e290", "source": "letter:32", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 32, "letter_url": "/letters/32/"}, {"id": "e291", "source": "letter:33", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 33, "letter_url": "/letters/33/"}, {"id": "e292", "source": "letter:33", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 33, "letter_url": "/letters/33/"}, {"id": "e293", "source": "letter:33", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 33, "letter_url": "/letters/33/"}, {"id": "e294", "source": "letter:33", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 33, "letter_url": "/letters/33/"}, {"id": "e295", "source": "letter:33", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 33, "letter_url": "/letters/33/"}, {"id": "e296", "source": "letter:34", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote to Your Paternity that I had placed myself in the hands of God, already sure of His divine will, which calls me to Japan by so many signs, and because Your Paternity, who stands in His place for me, has so interp", "I am God’s, of that most holy blood of Jesus Christ, and of so many poor little souls, delivered to Your Paternity as most unworthy son, in whose hands and at whose feet (so I feel impelled) I renew and make the vow of O"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e297", "source": "letter:34", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e298", "source": "letter:34", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e299", "source": "letter:34", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e300", "source": "letter:34", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e301", "source": "letter:34", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e302", "source": "letter:34", "target": "topic:obedience", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e303", "source": "letter:34", "target": "topic:vows", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e304", "source": "letter:34", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e305", "source": "letter:34", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e306", "source": "letter:34", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["Nor do I believe that my sins can stand against that incomprehensible Mercy, nor against the prayers of Your Paternity joined with those of the most precious Mother, of our Reverend Fathers Ignatius and Xavier, and of so"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e307", "source": "letter:34", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Nor do I believe that my sins can stand against that incomprehensible Mercy, nor against the prayers of Your Paternity joined with those of the most precious Mother, of our Reverend Fathers Ignatius and Xavier, and of so"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e308", "source": "letter:34", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["I did not trouble to ask Your Paternity to call me to Rome, because I do not think I stand less at your feet — with the confidence I owe to so many Fathers — than if I were in Rome bodily present."], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e309", "source": "letter:34", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e310", "source": "letter:34", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e311", "source": "letter:34", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 34, "letter_url": "/letters/34/"}, {"id": "e312", "source": "letter:35", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["But to open to Your Paternity what I wish, I say that I desire to go to China (as I have already asked), because I know for certain that this is the will of God, He having revealed it to me in prayer;"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e313", "source": "letter:35", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e314", "source": "letter:35", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e315", "source": "letter:35", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e316", "source": "letter:35", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e317", "source": "letter:35", "target": "person:trigault-nicolas", "type": "mentions_person", "label": "mentions", "evidence": ["From this, then, let Your Paternity know my desire, which is to go find Father Nicolò Trigault before he departs further;"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e318", "source": "letter:35", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e319", "source": "letter:35", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e320", "source": "letter:35", "target": "place:parma", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 35, "letter_url": "/letters/35/"}, {"id": "e321", "source": "letter:36", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["for hoping to be consoled by Your Paternity together with those Fathers who are now going to the Indies, you reply to me in your last letter that you are writing to the Father Rector that he write me in the catalogue of ", "My desire is to go to the Indies, and to be written down as one who has the vocation for the Indies;"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e322", "source": "letter:36", "target": "topic:martyrdom", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e323", "source": "letter:36", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["With the opportunity of the coming to Rome of Father Francesco Albertino, of whom I have until now been a companion, I could not refrain from writing four lines, showing you the great affliction my heart feels;"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e324", "source": "letter:36", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e325", "source": "letter:36", "target": "person:barletta-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e326", "source": "letter:36", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 36, "letter_url": "/letters/36/"}, {"id": "e327", "source": "letter:37", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I have learned from the letter of the Father Assistant of Portugal that Your Paternity, for I know not what news from Japan, wishes to defer our departure to next year, when we should have arrived to do some good.", "It was not enough for the devil that he would have driven me from Japan, unless he also confines us in Italy, shut up as in a narrow prison."], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e328", "source": "letter:37", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e329", "source": "letter:37", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e330", "source": "letter:37", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e331", "source": "letter:37", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e332", "source": "letter:37", "target": "place:italy", "type": "mentions_place", "label": "mentions", "evidence": ["It was not enough for the devil that he would have driven me from Japan, unless he also confines us in Italy, shut up as in a narrow prison."], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e333", "source": "letter:37", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["My Father, I stand clean in your hands: make and unmake of me as you please, provided that with your holy Sacrifices and prayers you keep me within the wounds of the Crucified, so that before going to Japan I may learn t"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e334", "source": "letter:37", "target": "place:naples", "type": "mentions_place", "label": "mentions", "evidence": ["If you assure me that staying in Naples does not make me more distant from Your Paternity than I would be in Rome, this too can be offered to the Lord."], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e335", "source": "letter:37", "target": "place:portugal", "type": "mentions_place", "label": "mentions", "evidence": ["I have learned from the letter of the Father Assistant of Portugal that Your Paternity, for I know not what news from Japan, wishes to defer our departure to next year, when we should have arrived to do some good."], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e336", "source": "letter:37", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["I would ask that Your Paternity call us meanwhile to Rome, so that I may stand more secure at your feet (for it seems to me that business is handled differently in person than by letters;", "and indeed those who were in Rome have departed — blessed be God)."], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e337", "source": "letter:37", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e338", "source": "letter:37", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e339", "source": "letter:37", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 37, "letter_url": "/letters/37/"}, {"id": "e340", "source": "letter:38", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 38, "letter_url": "/letters/38/"}, {"id": "e341", "source": "letter:38", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 38, "letter_url": "/letters/38/"}, {"id": "e342", "source": "letter:38", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 38, "letter_url": "/letters/38/"}, {"id": "e343", "source": "letter:38", "target": "place:parma", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 38, "letter_url": "/letters/38/"}, {"id": "e344", "source": "letter:39", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e345", "source": "letter:39", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e346", "source": "letter:39", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e347", "source": "letter:39", "target": "topic:tears", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e348", "source": "letter:39", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e349", "source": "letter:39", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e350", "source": "letter:39", "target": "person:balami-ignazio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e351", "source": "letter:39", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 39, "letter_url": "/letters/39/"}, {"id": "e352", "source": "letter:40", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I say, then, to Your Reverence that I am invited by that supreme King to the same table and to the same manner of life at which His blessed Son fed and in which He lived — that is, to be called to go to the Indies or to "], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e353", "source": "letter:40", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e354", "source": "letter:40", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e355", "source": "letter:40", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e356", "source": "letter:40", "target": "topic:novitiate", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e357", "source": "letter:40", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e358", "source": "letter:40", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e359", "source": "letter:40", "target": "person:abellone-hermete", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e360", "source": "letter:40", "target": "place:genoa", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 40, "letter_url": "/letters/40/"}, {"id": "e361", "source": "letter:41", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Many are the reasons and motives that impel me to write and to remind Your Paternity of my desire for the Indies: for if I turn toward the East, I see the blood shed by the holy Christians, which, like seed, promises mos"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e362", "source": "letter:41", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e363", "source": "letter:41", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e364", "source": "letter:41", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e365", "source": "letter:41", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e366", "source": "letter:41", "target": "person:fassari-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e367", "source": "letter:41", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 41, "letter_url": "/letters/41/"}, {"id": "e368", "source": "letter:42", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'Japan, mission to' (printed)"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e369", "source": "letter:42", "target": "topic:health", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e370", "source": "letter:42", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e371", "source": "letter:42", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e372", "source": "letter:42", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e373", "source": "letter:42", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["Believe me, my Father, that since October, since I have not written to Your Paternity, the hours seem years to me until I arrive at my Japan;", "May the Lord grant to Your Paternity every day a greater abundance of His treasures, for the universal good, and for those poor Japanese souls, and for the Society, and for the whole Church."], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e374", "source": "letter:42", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["But if anything can be added to the charity Your Paternity shows me, give me leave to ask of you one thing for its completion: that Your Paternity, not forgetting our exile, for the love of God call us quickly to Rome at"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e375", "source": "letter:42", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e376", "source": "letter:42", "target": "person:camassa-diego", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e377", "source": "letter:42", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 42, "letter_url": "/letters/42/"}, {"id": "e378", "source": "letter:43", "target": "place:brazil", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Wherefore, since God has called me to the salvation of souls, whether in China, or Japan, or Brazil, etc."], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e379", "source": "letter:43", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Wherefore, since God has called me to the salvation of souls, whether in China, or Japan, or Brazil, etc."], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e380", "source": "letter:43", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Wherefore, since God has called me to the salvation of souls, whether in China, or Japan, or Brazil, etc."], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e381", "source": "letter:43", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e382", "source": "letter:43", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e383", "source": "letter:43", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e384", "source": "letter:43", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e385", "source": "letter:43", "target": "place:brazil", "type": "mentions_place", "label": "mentions", "evidence": ["Therefore may Your Paternity, placed by God in such rank that you may govern His Religion, for love of Him, and for His greater honor, and the salvation of my soul, grant me leave for the next convenient occasion of the "], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e386", "source": "letter:43", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["Therefore may Your Paternity, placed by God in such rank that you may govern His Religion, for love of Him, and for His greater honor, and the salvation of my soul, grant me leave for the next convenient occasion of the "], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e387", "source": "letter:43", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e388", "source": "letter:43", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e389", "source": "letter:43", "target": "place:parma", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 43, "letter_url": "/letters/43/"}, {"id": "e390", "source": "letter:44", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["As the Lord urges me with continual desires that I ask of Your Paternity to go to the Indies, I am compelled to put it into execution by means of letters, since in no other way can I do it."], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e391", "source": "letter:44", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e392", "source": "letter:44", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e393", "source": "letter:44", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e394", "source": "letter:44", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e395", "source": "letter:44", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e396", "source": "letter:44", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e397", "source": "letter:44", "target": "person:fassari-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e398", "source": "letter:44", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 44, "letter_url": "/letters/44/"}, {"id": "e399", "source": "letter:45", "target": "place:brazil", "type": "aspires_to", "label": "desires to travel to", "evidence": ["but because I am always moved by the desire to aid souls — that are throughout the whole world, but, by particular grace of God, those that are either in the Indies, in China, or in Brazil and other like places — therefo"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e400", "source": "letter:45", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["but because I am always moved by the desire to aid souls — that are throughout the whole world, but, by particular grace of God, those that are either in the Indies, in China, or in Brazil and other like places — therefo"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e401", "source": "letter:45", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["but because I am always moved by the desire to aid souls — that are throughout the whole world, but, by particular grace of God, those that are either in the Indies, in China, or in Brazil and other like places — therefo"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e402", "source": "letter:45", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e403", "source": "letter:45", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e404", "source": "letter:45", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e405", "source": "letter:45", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e406", "source": "letter:45", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e407", "source": "letter:45", "target": "place:mantua", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 45, "letter_url": "/letters/45/"}, {"id": "e408", "source": "letter:46", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The better news concerned the affair of the Indies, and truly this time I expected to be told, and to accompany those two brothers who will go to Japan;", "Now, Our Father, I would desire this grace as a toast to the good news that comes from Japan, of the return of Our men to that Church of Japan;"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e409", "source": "letter:46", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["The better news concerned the affair of the Indies, and truly this time I expected to be told, and to accompany those two brothers who will go to Japan;", "In conclusion, you will give me leave that I, your least son, may continue to supplicate my most loving Father, reminding him that, as our Lord has given me the desire to conform myself to the will of Your Paternity and "], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e410", "source": "letter:46", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e411", "source": "letter:46", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e412", "source": "letter:46", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e413", "source": "letter:46", "target": "place:loreto", "type": "mentions_place", "label": "mentions", "evidence": ["And it is that Your Paternity is content to do me the charity that I come thither, and then go to visit the Holy House of Loreto."], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e414", "source": "letter:46", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e415", "source": "letter:46", "target": "person:barletta-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e416", "source": "letter:46", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 46, "letter_url": "/letters/46/"}, {"id": "e417", "source": "letter:47", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e418", "source": "letter:47", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e419", "source": "letter:47", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e420", "source": "letter:47", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e421", "source": "letter:47", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e422", "source": "letter:47", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Honey, yes, truly honey — of celestial consolations, which yield neither to nectar and ambrosia, nor to all the delights of all time, nor even to the spiritual tastes which the persons of our Society continually experien"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e423", "source": "letter:47", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e424", "source": "letter:47", "target": "person:gargano-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e425", "source": "letter:47", "target": "place:nola", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 47, "letter_url": "/letters/47/"}, {"id": "e426", "source": "letter:48", "target": "place:brazil", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I await also that Your Paternity may wish, and may explain to me his will — for my desire is so great to go either to China, or Japan, or the Indies, or Brazil, etc.", "and for this, trusting first in God, then in that great desire which Your Paternity shows in that letter, that we go to fish for souls in those countries, I await the license (there being so convenient an occasion at pre"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e427", "source": "letter:48", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I await also that Your Paternity may wish, and may explain to me his will — for my desire is so great to go either to China, or Japan, or the Indies, or Brazil, etc."], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e428", "source": "letter:48", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I await also that Your Paternity may wish, and may explain to me his will — for my desire is so great to go either to China, or Japan, or the Indies, or Brazil, etc."], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e429", "source": "letter:48", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I await also that Your Paternity may wish, and may explain to me his will — for my desire is so great to go either to China, or Japan, or the Indies, or Brazil, etc."], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e430", "source": "letter:48", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e431", "source": "letter:48", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e432", "source": "letter:48", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e433", "source": "letter:48", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e434", "source": "letter:48", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e435", "source": "letter:48", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e436", "source": "letter:48", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e437", "source": "letter:48", "target": "place:mantua", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 48, "letter_url": "/letters/48/"}, {"id": "e438", "source": "letter:49", "target": "place:china", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Index of Topics: 'China, mission to' (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e439", "source": "letter:49", "target": "place:japan", "type": "aspires_to", "label": "desires to travel to", "evidence": ["And thinking that it had arrived, when there arrived at Modena those two Fathers, one of whom was going to Portugal, the other to Japan, with whom I should accompany them, I stood all glad at seeing them;"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e440", "source": "letter:49", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["but know that until you have fulfilled my desire to go to the Indies, etc.", "To tell the truth, I cannot find rest neither day nor night, for I always have my thought fixed, meditating in this fashion: when will Your Paternity give me that so-desired license to go to the Indies, that there I may "], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e441", "source": "letter:49", "target": "topic:china-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e442", "source": "letter:49", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e443", "source": "letter:49", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e444", "source": "letter:49", "target": "topic:japan-mission-to", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e445", "source": "letter:49", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e446", "source": "letter:49", "target": "topic:zeal-for-souls", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e447", "source": "letter:49", "target": "place:brazil", "type": "mentions_place", "label": "mentions", "evidence": ["and I pray you, for the love of the Most Blessed Virgin Mary, if anything avails with Your Paternity, and for the love of Christ, who stimulates me to so great a work — for so it pleases Him — give me as soon as possible"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e448", "source": "letter:49", "target": "place:china", "type": "mentions_place", "label": "mentions", "evidence": ["and I pray you, for the love of the Most Blessed Virgin Mary, if anything avails with Your Paternity, and for the love of Christ, who stimulates me to so great a work — for so it pleases Him — give me as soon as possible"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e449", "source": "letter:49", "target": "place:japan", "type": "mentions_place", "label": "mentions", "evidence": ["and I pray you, for the love of the Most Blessed Virgin Mary, if anything avails with Your Paternity, and for the love of Christ, who stimulates me to so great a work — for so it pleases Him — give me as soon as possible"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e450", "source": "letter:49", "target": "place:modena", "type": "mentions_place", "label": "mentions", "evidence": ["And thinking that it had arrived, when there arrived at Modena those two Fathers, one of whom was going to Portugal, the other to Japan, with whom I should accompany them, I stood all glad at seeing them;", "And I, meanwhile, while I wait, shall attend to my school, which the Father Provincial has given me in Modena."], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e451", "source": "letter:49", "target": "place:portugal", "type": "mentions_place", "label": "mentions", "evidence": ["And thinking that it had arrived, when there arrived at Modena those two Fathers, one of whom was going to Portugal, the other to Japan, with whom I should accompany them, I stood all glad at seeing them;"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e452", "source": "letter:49", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e453", "source": "letter:49", "target": "person:rondonio-antonio", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e454", "source": "letter:49", "target": "place:modena", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 49, "letter_url": "/letters/49/"}, {"id": "e455", "source": "letter:50", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Although the seeing of our companions called to go and cultivate the field of the Lord in the Indies, and our being left behind, brings us a good and holy envy, and an inconsolable desire to want to be their companions —"], "letter": 50, "letter_url": "/letters/50/"}, {"id": "e456", "source": "letter:50", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 50, "letter_url": "/letters/50/"}, {"id": "e457", "source": "letter:50", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 50, "letter_url": "/letters/50/"}, {"id": "e458", "source": "letter:50", "target": "person:fassari-vincenzo", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 50, "letter_url": "/letters/50/"}, {"id": "e459", "source": "letter:50", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 50, "letter_url": "/letters/50/"}, {"id": "e460", "source": "letter:51", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e461", "source": "letter:51", "target": "topic:cross-and-suffering", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e462", "source": "letter:51", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e463", "source": "letter:51", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e464", "source": "letter:51", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e465", "source": "letter:51", "target": "person:gargano-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e466", "source": "letter:51", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 51, "letter_url": "/letters/51/"}, {"id": "e467", "source": "letter:52", "target": "place:loreto", "type": "aspires_to", "label": "desires to travel to", "evidence": ["I wrote to Your Paternity in months past that I wished to go to Our Lady of Loreto, and I ask whether Your Paternity would grant me this grace: to come barefoot and on foot, and to come by way of Rome to see Your Paterni"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e468", "source": "letter:52", "target": "topic:angels", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e469", "source": "letter:52", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e470", "source": "letter:52", "target": "topic:ignatius-of-loyola-st", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e471", "source": "letter:52", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e472", "source": "letter:52", "target": "topic:xavier-st-francis", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e473", "source": "letter:52", "target": "person:loyola-ignatius-of", "type": "mentions_person", "label": "mentions", "evidence": ["Yet I ask this by the merits of our Blessed Father Ignatius and of Blessed Xavier — apropos of those parts whither I wish to go — and, so as to trouble Your Paternity no more, I promise to give you no more trouble, for I"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e474", "source": "letter:52", "target": "person:xavier-francis", "type": "mentions_person", "label": "mentions", "evidence": ["Yet I ask this by the merits of our Blessed Father Ignatius and of Blessed Xavier — apropos of those parts whither I wish to go — and, so as to trouble Your Paternity no more, I promise to give you no more trouble, for I"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e475", "source": "letter:52", "target": "place:loreto", "type": "mentions_place", "label": "mentions", "evidence": ["I wrote to Your Paternity in months past that I wished to go to Our Lady of Loreto, and I ask whether Your Paternity would grant me this grace: to come barefoot and on foot, and to come by way of Rome to see Your Paterni"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e476", "source": "letter:52", "target": "place:rome", "type": "mentions_place", "label": "mentions", "evidence": ["I wrote to Your Paternity in months past that I wished to go to Our Lady of Loreto, and I ask whether Your Paternity would grant me this grace: to come barefoot and on foot, and to come by way of Rome to see Your Paterni"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e477", "source": "letter:52", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e478", "source": "letter:52", "target": "person:barletta-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e479", "source": "letter:52", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 52, "letter_url": "/letters/52/"}, {"id": "e480", "source": "letter:53", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["It is proper to the son to ask of his father, as I have done many times with Your Paternity, my most dear Father — that is, asking many times to be sent to those parts of the Indies for the greater service of God."], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e481", "source": "letter:53", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e482", "source": "letter:53", "target": "place:barletta", "type": "mentions_place", "label": "mentions", "evidence": ["I find myself in Barletta to this end: to detach myself from my mother, that I may be more ready, as Your Paternity wrote me to do;"], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e483", "source": "letter:53", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e484", "source": "letter:53", "target": "person:barletta-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e485", "source": "letter:53", "target": "place:barletta", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 53, "letter_url": "/letters/53/"}, {"id": "e486", "source": "letter:54", "target": "topic:blood-of-christ", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e487", "source": "letter:54", "target": "topic:humility", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e488", "source": "letter:54", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e489", "source": "letter:54", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e490", "source": "letter:54", "target": "person:gargano-francesco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e491", "source": "letter:54", "target": "place:naples", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 54, "letter_url": "/letters/54/"}, {"id": "e492", "source": "letter:55", "target": "place:the-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["On the occasion of the feast of the Holy Spirit I could not do otherwise than manifest to Your Paternity the flame — not wholly hidden from you — which, with the coming of this divine fire sent from Heaven, has grown in "], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e493", "source": "letter:55", "target": "topic:heaven-hell-and-purgatory", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e494", "source": "letter:55", "target": "topic:studies", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e495", "source": "letter:55", "target": "topic:virgin-mary", "type": "indexed_under", "label": "indexed under", "evidence": ["Index of Topics (printed)"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e496", "source": "letter:55", "target": "person:vitelleschi-mutio", "type": "recipient", "label": "addressed to", "evidence": ["addressed"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e497", "source": "letter:55", "target": "person:stella-marco", "type": "written_by", "label": "written by", "evidence": ["byline"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e498", "source": "letter:55", "target": "place:palermo", "type": "written_in", "label": "written in", "evidence": ["byline"], "letter": 55, "letter_url": "/letters/55/"}, {"id": "e499", "source": "letter:56", "target": "place:east-indies", "type": "aspires_to", "label": "desires to travel to", "evidence": ["Althou