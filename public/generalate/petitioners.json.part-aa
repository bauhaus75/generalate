  "letters": [
   {
    "n": 5,
    "year": 1616,
    "date": "January 24, 1616",
    "place": "Palermo",
    "archival": "ARSI, FG 735, 328",
    "excerpt": "Although only a few days ago I wrote to Your Paternity asking leave to go to the East Indies, I have wished anew to remind you, to satisfy in part the great desire I have to obtain this grace, and to kindle myself the more, assuring myself that Your Paternity will grant it to me — all the more since I have heard that five have been called from Messina, and that from this college they will soon be notified; for this, most beloved Father, I urge you as much as possible that, for the wounds of Christ our Lord, whose love constrains me to make you this request, you would deign to console me in this.",
    "kind": "abridged",
    "full_paras": [
     "Although only a few days ago I wrote to Your Paternity asking leave to go to the East Indies, I have wished anew to remind you, to satisfy in part the great desire I have to obtain this grace, and to kindle myself the more, assuring myself that Your Paternity will grant it to me — all the more since I have heard that five have been called from Messina, and that from this college they will soon be notified; for this, most beloved Father, I urge you as much as possible that, for the wounds of Christ our Lord, whose love constrains me to make you this request, you would deign to console me in this. I commend myself to the holy sacrifices and prayers of Your Paternity."
    ]
   }
  ]
 },
 {
  "id": "hist-6",
  "fictional": false,
  "name": "Francesco Maria Armillei",
  "author_raw": "Francesco Maria Armillei",
  "age": null,
  "yearsInSociety": null,
  "formation": null,
